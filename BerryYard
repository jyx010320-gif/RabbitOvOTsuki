  transform:rotate(-8deg);letter-spacing:0;
}
.seal.gold{transform:rotate(7deg)}
.seal.on{border-style:solid;border-color:var(--accent);color:var(--accent);opacity:1;background:color-mix(in srgb,var(--accent) 9%,transparent)}
