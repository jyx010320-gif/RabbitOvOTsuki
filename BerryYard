  const PINE_TYPES = ['leaf', 'straw', 'flower', 'orange', 'melon', 'kiwi', 'heart', 'pine'];
  const LATE_TYPES = ['peach', 'leaf', 'orange', 'melon', 'gem', 'kiwi', 'heart', 'pine'];
  const DAILY_TYPES = ['peach', 'leaf', 'flower', 'orange', 'melon', 'gem', 'heart'];
  const WEEK_TYPES = ['peach', 'leaf', 'flower', 'star', 'orange', 'gem', 'heart'];
