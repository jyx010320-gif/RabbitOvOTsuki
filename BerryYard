.sub-chip b{font-family:inherit;font-weight:700;font-size:14px;color:var(--accent);margin:0 2px;letter-spacing:0}
.sub-lede{margin:0;padding:0 5px;font-size:13px;line-height:1.7;color:var(--ink-soft)}
.dex-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
@media (min-width:760px){.dex-grid{grid-template-columns:repeat(6,1fr);gap:10px}.dex-art{width:64px;height:64px}}
.dex-card{
