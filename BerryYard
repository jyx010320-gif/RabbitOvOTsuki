  function goalFor(level) {
    const info = chapterInfo(level);
    const def = info.def;
    const diff = diffFor(level);
    const cyc = Math.min(3, info.cycle);
    const type = def.goal;
    if (type === 'basket') {
      return { type, need: Math.min(26, 9 + diff * 2 + (def.extra || 0) + cyc * 2), got: 0 };
    }
    if (type === 'clear') {
      return { type, need: Math.min(7, 3 + diff + (def.extraBlock || 0) + cyc), got: 0 };
    }
    if (type === 'order') {
      const count = def.parts || 3;
      const pool = state.types && state.types.length ? state.types : CORE_TYPES;
      const off = Math.abs(hashStr('xiaoyuan-order-' + level)) % pool.length;
      const base = (count >= 4 ? 2 : 1 + Math.floor(diff / 2)) + Math.min(1, cyc);
      const parts = [];
      for (let i = 0; i < count; i++) {
        parts.push({ t: pool[(off + i) % pool.length], need: base + (i === 0 ? 1 : 0), got: 0 });
      }
      return { type, need: 1, got: 0, parts };
    }
    if (type === 'fog') {
      return { type, need: Math.min(11, 5 + diff + (def.extra || 0) + cyc), got: 0 };
    }
    if (type === 'lantern') {
      return { type, need: Math.min(4, 1 + Math.floor(diff / 2) + (def.extra || 0) + Math.min(1, cyc)), got: 0 };
    }
    return { type: 'combo', need: Math.min(8, 3 + diff + (def.extra || 0) + cyc), got: 0 };
  }

  function starTargetFor(level) {
    const info = chapterInfo(level);
    return Math.min(7000, 2100 + diffFor(level) * 260 + (info.chapter - 1) * 20 + info.cycle * 160);
