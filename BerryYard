  function exitSideMode() {
    if (!isSideMode()) return;
    if (state.mode === 'daily') { exitDaily(); return; }
    state.mode = 'story';
    state.score = state.storyScore || 0;
    startLevel(state.storyLevel || state.level, true);
    toast('回到小院');
  }

  function startMode(key) {
    ensureAudio();
    if (state.busy) { toast('等这一手消完'); return; }
    if (key === 'resume') { closePage(); return; }
    if (key === 'story') {
      closePage();
      if (state.mode === 'weekly') exitWeekly();
      else if (isSideMode()) exitSideMode();
      state.mode = 'story';
      setActiveTab('game');
      return;
    }
    if (state.mode === key && !state.over) { closePage(); return; }
    closePage();
    if (key === 'daily') startDaily();
    else if (key === 'score') startScoreRun();
    else if (key === 'zen') startZen();
    else if (key === 'challenge') startChallenge();
  }

