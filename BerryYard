  function chapterOf(level) { return Math.floor((level - 1) / CHAPTER_LEN) + 1; }

  function chapterInfo(level) {
    const chapter = chapterOf(level);
    const def = CHAPTER_DEFS[(chapter - 1) % CHAPTER_DEFS.length];
    return {
      chapter,
      inChapter: ((level - 1) % CHAPTER_LEN) + 1,
      cycle: Math.floor((chapter - 1) / CHAPTER_DEFS.length),
