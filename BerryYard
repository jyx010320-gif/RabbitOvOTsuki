.dex-card.zero{opacity:.62}
.dex-card.zero em{color:var(--muted)}
.dex-seals{display:flex;gap:4px;margin-top:1px}
.seal{
  width:19px;height:19px;display:grid;place-items:center;
  border:1.2px dashed var(--frame-line-strong);border-radius:50%;
