  const CHALLENGE_TYPES = ['leaf', 'flower', 'star', 'orange', 'melon', 'gem', 'heart'];

  function typesForStory(level) {
    // 每 10 关换一篮果子：先加新果，后期在八果盘里轮换
    const band = Math.floor((level - 1) / 10);
    const early = [CORE_TYPES, ORANGE_TYPES, STRAW_TYPES, KIWI_TYPES, CHERRY_TYPES, PINE_TYPES];
    if (band < early.length) return early[band];
    const late = [CHERRY_TYPES, PINE_TYPES, LATE_TYPES];
    return late[(band - 6) % late.length];
  }

  function diffFor(level) {
    const base = Math.min(4, 1 + Math.floor((chapterOf(level) - 1) / 4));
    const h = Math.abs(hashStr('xiaoyuan-diff-' + level));
    return Math.min(5, base + (h % 3));
  }

  function movesFor(level) {
    const info = chapterInfo(level);
    const diff = diffFor(level);
    return Math.max(18, START_MOVES - (diff >= 4 ? 2 : diff >= 3 ? 1 : 0) + (info.def.moves || 0) - Math.min(2, info.cycle));
  }

