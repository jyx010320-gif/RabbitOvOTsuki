.tab .badge{
  position:absolute;top:1px;left:calc(50% + 9px);min-width:16px;height:16px;border-radius:8px;
  background:var(--accent);color:#FFF7FB;font-style:normal;font-size:10px;line-height:16px;
  text-align:center;padding:0 4px;font-weight:700;
}
.tab .badge.hide{display:none}

/* 提示小按钮 */
