    try {
      const raw = localStorage.getItem(key);
      if (!raw) return fallback;
      const v = JSON.parse(raw);
      return v == null ? fallback : v;
    } catch (err) { return fallback; }
  }

  function writeStore(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch (err) { /* 忽略 */ }
  }

  function loadStars() {
    const v = readStore(STARS_KEY, {});
    return v && typeof v === 'object' ? v : {};
  }

  function starsFor(level) {
    const v = Number(loadStars()[String(level)] || 0);
    return Number.isFinite(v) ? v : 0;
  }

  function saveStars(level, stars) {
    const all = loadStars();
    if (stars > Number(all[String(level)] || 0)) {
      all[String(level)] = stars;
      writeStore(STARS_KEY, all);
    }
  }

  function loadOil() {
    try {
      const raw = localStorage.getItem(OIL_KEY);
      if (raw == null) return 3;
      const v = Number(raw);
      return Number.isFinite(v) && v >= 0 ? Math.min(99, Math.floor(v)) : 3;
    } catch (err) { return 3; }
  }

  function saveOil(n) {
    state.oil = Math.max(0, Math.min(99, n));
    try { localStorage.setItem(OIL_KEY, String(state.oil)); } catch (err) { /* 忽略 */ }
    if (oilValEl) oilValEl.textContent = state.oil;
  }

  function addOil(n) { saveOil(state.oil + n); }

  function pad2(n) { return (n < 10 ? '0' : '') + n; }

  function todayKey() {
    const d = new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
  }

  function dayIndex() {
    const d = new Date();
    return Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
  }

  function hashStr(str) {
    let h = 2166136261;
    for (let i = 0; i < str.length; i++) {
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return h >>> 0;
  }

  function loadDaily() {
    const r = readStore(DAILY_KEY, null);
    if (r && r.date === todayKey()) {
      return {
        date: r.date,
        left: Math.max(0, Math.min(DAILY_ATTEMPTS, Number(r.left) || 0)),
        done: !!r.done,
        best: Number(r.best) || 0,
        stars: Number(r.stars) || 0
      };
    }
    return { date: todayKey(), left: DAILY_ATTEMPTS, done: false, best: 0, stars: 0 };
  }

  function loadCollect() {
    const v = readStore(COLLECT_KEY, {});
    const out = {};
    for (const t of TYPES) out[t] = Math.max(0, Number(v && v[t]) || 0);
    return out;
  }

  function countCollection(cells) {
    if (!collectData) collectData = loadCollect();
    for (const k of cells) {
      const [r, c] = parseKey(k);
      const t = grid[r][c];
      if (t && t.type !== 'rainbow') {
        collectData[t.type] = (collectData[t.type] || 0) + 1;
      }
    }
    writeStore(COLLECT_KEY, collectData);
  }

  function saveDaily(r) {
    writeStore(DAILY_KEY, r);
    refreshDailyBadge();
  }

  /* ---------- 灯笼 ---------- */
  function buildLanterns() {
    lanternsEl.innerHTML = '<span>门廊</span>';
    for (let i = 0; i < 3; i++) {
      const d = document.createElement('div');
      d.className = 'lantern';
      d.innerHTML = LANTERN_SVG;
      lanternsEl.appendChild(d);
    }
  }

  function updateLantern(popIndex) {
    const lamps = lanternsEl.querySelectorAll('.lantern');
    lamps.forEach((n, i) => {
      n.classList.toggle('on', i < state.lantern);
      if (popIndex === i) {
        n.classList.remove('pop');
        void n.offsetWidth;
        n.classList.add('pop');
      }
    });
  }

  function tickLantern() {
    if (state.lantern >= 3) return;
    state.lanternTicks++;
    if (state.lanternTicks < 3) return;
    state.lanternTicks = 0;
    state.lantern++;
    updateLantern(state.lantern - 1);
    playLantern(state.lantern);
    if (state.lantern >= 3) {
      state.courtReady = true;
      toast('门廊三盏灯全亮了');
    }
  }

  async function fullCourt() {
    state.courtReady = false;
    if (state.goal && state.goal.type === 'lantern') {
      state.goal.got = Math.min(state.goal.need, state.goal.got + 1);
      updateGoalUi();
    }
    state.lantern = 0;
    state.lanternTicks = 0;
    updateLantern();
    courtEl.classList.remove('on');
    void courtEl.offsetWidth;
    courtEl.classList.add('on');
    playCourt();

    const counts = new Map();
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const t = grid[r][c];
        if (!t || t.type === 'rainbow') continue;
        counts.set(t.type, (counts.get(t.type) || 0) + 1);
      }
    }
    let best = null, bestN = 0;
    for (const [k, n] of counts) {
      if (n > bestN) { bestN = n; best = k; }
    }
    if (!best) return;

    const cells = new Set();
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const t = grid[r][c];
        if (t && t.type === best) cells.add(keyOf(r, c));
      }
    }
    if (!cells.size) return;

    const gained = cells.size * 18 + 180;
    addScore(gained);
    floatScore(cells, gained);
    countGoal(cells);
    countCollection(cells);
    dissolveCovers(cells);
    dissolveBlocks(cells);
    toast('满院灯火 · ' + (TYPE_NAMES[best] || best) + ' 全收进来了');

    for (const k of cells) {
      const [r, c] = parseKey(k);
      const t = grid[r][c];
      if (t) t.el.classList.add('pop');
    }
    playPop(3);
    await sleep(240);
    for (const k of cells) {
      const [r, c] = parseKey(k);
      const t = grid[r][c];
      if (t) {
        t.el.remove();
        grid[r][c] = null;
      }
    }
    await dropAndFill();
    state.inCourt = true;
    await resolve(null);
    state.inCourt = false;
  }

  /* ---------- 关卡目标 ---------- */
  function levelScore() { return Math.max(0, state.score - state.levelStart); }

  function goalDone() {
    const g = state.goal;
    return !!g && g.got >= g.need;
  }

  function goalProgressText() {
    const g = state.goal;
    if (g.type === 'basket') return (TYPE_NAMES[state.basketType] || state.basketType) + ' ' + g.got + '/' + g.need;
    if (g.type === 'fog') return '雾气 ' + g.got + '/' + g.need + ' 格';
    if (g.type === 'lantern') return '满院灯火 ' + g.got + '/' + g.need + ' 次';
    if (g.type === 'clear') return '已清 ' + g.got + '/' + g.need + ' 处';
    if (g.type === 'order') {
      if (g.parts.length > 3) {
        const line = (arr) => arr.map((p) => (TYPE_SHORT[p.t] || p.t) + p.got + '/' + p.need).join('·');
        return line(g.parts.slice(0, 2)) + '\n' + line(g.parts.slice(2));
      }
      return g.parts.map((p) => (TYPE_NAMES[p.t] || p.t) + ' ' + p.got + '/' + p.need).join(' · ');
    }
    return '连击 ' + g.got + '/' + g.need + ' 次';
  }

  function liveStars() {
    let s = 0;
    if (goalDone()) s = 1;
    if (goalDone() && state.moves >= 4) s = 2;
    if (s >= 2 && levelScore() >= starTargetNow()) s = 3;
    return s;
  }

  function updateGoalUi() {
    const g = state.goal;
    if (!g) return;
    if (g.type === 'zen') {
      goalNameEl.textContent = '随心';
      goalIconEl.innerHTML = '<svg class="gl-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14.4A7.6 7.6 0 0 1 9.6 5 7.9 7.9 0 1 0 9.4 19.4Z"/><path d="M17.2 4.4v2.6M16 5.7h2.4"/></svg>';
      goalTextEl.textContent = '不限步数 · 慢慢收';
      barEl.style.width = '100%';
      starRowEl.hidden = true;
      starRowEl.querySelectorAll('.sstar').forEach((el) => el.classList.remove('on'));
      return;
    }
    if (g.type === 'score') {
      const isWeek = state.mode === 'weekly';
      starRowEl.hidden = !isWeek;
      goalNameEl.textContent = isWeek ? '周赛' : '冲分';
      goalIconEl.innerHTML = isWeek
        ? '<svg class="gl-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v3.4a4 4 0 0 1-8 0Z"/><path d="M8 5.4H5.4v1.4a3 3 0 0 0 3 3M16 5.4h2.6v1.4a3 3 0 0 1-3 3"/><path d="M12 11.4v4"/><path d="M8.6 19.6h6.8l-.7-3.2H9.3Z"/></svg>'
        : '<svg class="gl-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5"/><path d="M6.4 10.6 12 5l5.6 5.6"/><path d="M5.4 20h13.2"/></svg>';
      goalTextEl.textContent = '本轮 ' + state.score.toLocaleString('zh-CN') + ' · 最好 ' + (state.runBest || 0).toLocaleString('zh-CN');
      barEl.style.width = (Math.min(1, state.score / (isWeek ? WEEK_TARGET : 2000)) * 100).toFixed(2) + '%';
      starRowEl.querySelectorAll('.sstar').forEach((el) => el.classList.remove('on'));
      return;
    }
    goalNameEl.textContent = GOAL_NAMES[g.type] || '目标';
    starRowEl.hidden = state.mode === 'challenge';
    if (g.type === 'basket') {
      goalIconEl.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true">' + (PIECES[state.basketType] || '') + '</svg>';
    } else {
      goalIconEl.innerHTML = GOAL_ICONS[g.type] || '';
    }
    goalTextEl.textContent = goalProgressText();
    goalTextEl.classList.toggle('four', g.type === 'order' && g.parts && g.parts.length > 3);
    barEl.style.width = (Math.min(1, g.got / g.need) * 100).toFixed(2) + '%';
    const s = liveStars();
    starRowEl.querySelectorAll('.sstar').forEach((el, i) => el.classList.toggle('on', i < s));
    starRowEl.title = '1★ 完成目标 · 2★ 余步≥4 · 3★ ' + starTargetNow() + ' 分';
  }

  function countGoal(cells) {
    const g = state.goal;
    if (!g) return 0;
    if (g.type === 'basket') {
      let gain = 0;
      for (const k of cells) {
        const [r, c] = parseKey(k);
        const t = grid[r][c];
        if (t && t.type === state.basketType) gain++;
      }
      if (!gain) return 0;
      g.got = Math.min(g.need, g.got + gain);
      updateGoalUi();
      return gain;
    }
    if (g.type === 'order') {
      let hit = 0;
      for (const k of cells) {
        const [r, c] = parseKey(k);
        const t = grid[r][c];
        if (!t) continue;
        for (const p of g.parts) {
          if (p.t === t.type && p.got < p.need) { p.got++; hit++; }
        }
      }
      if (!hit) return 0;
      if (g.parts.every((p) => p.got >= p.need)) {
        g.got = 1;
        toast('花篮订单交货了');
      }
      updateGoalUi();
      return hit;
    }
    return 0;
  }

  /* ---------- 天气遮盖 ---------- */
  function coverTip(kind) {
    if (kind === 'fog') return '雾还没散，先消掉旁边的果子';
    if (kind === 'rain') return '雨珠挡着，贴着它消掉就化开';
    return '叶子挡着，消掉旁边的果子就扫开';
  }

  function coverEl(kind, r, c) {
    const el = document.createElement('div');
    el.className = 'cover ' + kind;
    el.dataset.k = keyOf(r, c);
    el.style.setProperty('--r', r);
    el.style.setProperty('--c', c);
    if (kind === 'rain') {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 20c14 22 21 34 21 44a21 21 0 1 1-42 0c0-10 7-22 21-44Z" fill="#9FCFE2" opacity=".92"/><ellipse cx="42" cy="50" rx="6.5" ry="10" fill="#fff" opacity=".5"/></svg>';
    } else if (kind === 'leaf') {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M74 16c0 26-18 42-40 40-5 0-8-2-8-2s2-28 18-36c12-6 30-6 30-2Z" fill="#D89A54" opacity=".95"/><path d="M28 62l34-26" stroke="#A9702F" stroke-width="2" opacity=".5" fill="none"/></svg>';
    }
    return el;
  }

  function renderCovers() {
    coverLayer.innerHTML = '';
    for (const [k, kind] of coverAt) {
      const [r, c] = parseKey(k);
      coverLayer.appendChild(coverEl(kind, r, c));
    }
  }

  function spawnCovers(kind, count, area) {
    let placed = 0, guard = 0;
    while (placed < count && guard++ < 90) {
      const r = area === 'bottom' ? ROWS - 1 - Math.floor(rnd() * 2) : Math.floor(rnd() * ROWS);
      const c = Math.floor(rnd() * COLS);
      const k = keyOf(r, c);
      if (coverAt.has(k)) continue;
      coverAt.set(k, kind);
      placed++;
    }
    renderCovers();
    return placed;
  }

  function dissolveCovers(cells) {
    let n = 0;
    for (const k of cells) {
      const [r, c] = parseKey(k);
      for (const [dr, dc] of [[0, 0], ...DIRS]) {
        const rr = r + dr, cc = c + dc;
        if (rr < 0 || rr >= ROWS || cc < 0 || cc >= COLS) continue;
        const kk = keyOf(rr, cc);
        if (!coverAt.has(kk)) continue;
        coverAt.delete(kk);
        const el = coverLayer.querySelector('[data-k="' + kk + '"]');
        if (el) {
          el.classList.add('breaking');
          setTimeout(() => el.remove(), 320);
        }
        n++;
      }
    }
    if (n) {
      addScore(n * 12);
      if (state.goal && state.goal.type === 'fog') {
        state.goal.got = Math.min(state.goal.need, state.goal.got + n);
        updateGoalUi();
      }
    }
    return n;
  }

  /* ---------- 障碍机关：藤蔓 / 冰壳 / 锁链 / 落叶堆 ---------- */
  function seasonBlockKind() {
    const se = seasonKey();
    if (se === 'winter') return 'ice';
    if (se === 'autumn') return 'pile';
    if (se === 'spring') return 'vine';
    return 'chain';
  }

  function blockTip(kind) {
    if (kind === 'vine') return '藤蔓缠着，消掉旁边的果子就松开';
    if (kind === 'ice') return '冰壳冻住了，贴着消掉就化开';
    if (kind === 'chain') return '锁链扣着，旁边消一组就解开';
    return '落叶堆着，消掉旁边就扫开';
  }

  function blockEl(kind, r, c) {
    const el = document.createElement('div');
    el.className = 'block ' + kind;
    el.dataset.bk = keyOf(r, c);
    el.style.setProperty('--r', r);
    el.style.setProperty('--c', c);
    if (kind === 'vine') {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M18 82c20-30 32-32 20-58M82 18c-26 22-8 40-34 30M30 20c14 8 6 22 32 22M68 80c-16-8-6-24-26-26" stroke="#5E9B66" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M38 38c-8 4-12 2-16-4M62 60c8-4 12-2 16 4" stroke="#78AE72" stroke-width="4" fill="none" stroke-linecap="round"/><ellipse cx="30" cy="26" rx="9" ry="5" fill="#83B97B" transform="rotate(-28 30 26)"/><ellipse cx="70" cy="74" rx="9" ry="5" fill="#83B97B" transform="rotate(-28 70 74)"/></svg>';
    } else if (kind === 'ice') {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 10l28 16v40L50 90 22 66V26Z" fill="#BFE4F5" opacity=".72" stroke="#F4FDFF" stroke-width="2"/><path d="M50 10v80M22 26l56 40M78 26l-56 40" stroke="#FFFFFF" stroke-width="1.6" opacity=".6"/><path d="M22 66l28-18 28 18" stroke="#FFFFFF" stroke-width="2" opacity=".5" fill="none"/></svg>';
    } else if (kind === 'chain') {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><ellipse cx="38" cy="38" rx="18" ry="11" fill="none" stroke="#6E737B" stroke-width="6" transform="rotate(-38 38 38)"/><ellipse cx="62" cy="62" rx="18" ry="11" fill="none" stroke="#6E737B" stroke-width="6" transform="rotate(-38 62 62)"/><ellipse cx="42" cy="64" rx="14" ry="9" fill="none" stroke="#8A9098" stroke-width="5" transform="rotate(42 42 64)"/><path d="M18 18l18 18M82 82l-18-18" stroke="#8A9098" stroke-width="4" stroke-linecap="round"/></svg>';
    } else {
      el.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="M16 78c8-18 24-20 34-30 4 12-6 24-14 30Z" fill="#C88548" stroke="#F0C08C" stroke-width="1.6"/><path d="M84 78c-8-18-24-20-34-30-4 12 6 24 14 30Z" fill="#D79A54" stroke="#F0C08C" stroke-width="1.6"/><path d="M50 44c-16 8-20 26-12 38h24c8-12 4-30-12-38Z" fill="#E6AC62"/><path d="M30 82l14-24M70 82l-14-24M50 46v36" stroke="#A9702F" stroke-width="2" opacity=".45" fill="none"/></svg>';
    }
    el.innerHTML += '<svg class="block-lock" viewBox="0 0 24 24" aria-hidden="true"><rect x="4.4" y="10.2" width="15.2" height="10.6" rx="2.2"/><path d="M8 10.2V7.4a4 4 0 0 1 8 0v2.8"/><circle cx="12" cy="15.4" r="1.7"/></svg>';
    return el;
  }

  function renderBlocks() {
    blockLayer.innerHTML = '';
    for (const [k, kind] of blockAt) {
      const [r, c] = parseKey(k);
      blockLayer.appendChild(blockEl(kind, r, c));
    }
  }

  function spawnBlocks(count, kind) {
    let placed = 0, guard = 0;
    while (placed < count && guard++ < 120) {
      const r = Math.floor(rnd() * ROWS);
      const c = Math.floor(rnd() * COLS);
      const k = keyOf(r, c);
      if (blockAt.has(k) || coverAt.has(k)) continue;
      blockAt.set(k, kind || 'vine');
      placed++;
    }
    renderBlocks();
    return placed;
  }

  function dissolveBlocks(cells) {
    let n = 0;
    for (const k of cells) {
      const [r, c] = parseKey(k);
      for (const [dr, dc] of [[0, 0], ...DIRS]) {
        const rr = r + dr, cc = c + dc;
        if (rr < 0 || rr >= ROWS || cc < 0 || cc >= COLS) continue;
        const kk = keyOf(rr, cc);
        if (!blockAt.has(kk)) continue;
        blockAt.delete(kk);
        const el = blockLayer.querySelector('[data-bk="' + kk + '"]');
        if (el) {
          el.classList.add('breaking');
          setTimeout(() => el.remove(), 340);
        }
        n++;
      }
    }
    if (n) {
      addScore(n * 18);
      if (state.goal && state.goal.type === 'clear') {
        state.goal.got = Math.min(state.goal.need, state.goal.got + n);
        updateGoalUi();
      }
    }
    return n;
  }

  function setupObstacles(level) {
    blockAt.clear();
    renderBlocks();
    const g = state.goal;
    const info = state.mode === 'story' ? chapterInfo(level) : null;
    const extra = info ? (info.def.extraBlock || 0) + (diffFor(level) >= 4 ? 1 : 0) : 0;
    if (g && g.type === 'clear') {
      const n = g.need + 1 + Math.min(1, extra);
      spawnBlocks(n, seasonBlockKind());
      const chain = Math.max(0, Math.min(2, 8 - n));
      if (chain) spawnBlocks(chain, 'chain');
    } else if (state.mode === 'story' && level >= 2) {
      spawnBlocks(2 + extra, seasonBlockKind());
    } else if (state.mode === 'daily') {
      spawnBlocks(2, seasonBlockKind());
    } else if (state.mode === 'weekly') {
      spawnBlocks(3, seasonBlockKind());
    } else if (state.mode === 'score') {
      spawnBlocks(2, seasonBlockKind());
    }
    let guard = 0;
    while (!hasValidMove() && blockAt.size && guard++ < 10) {
      const last = Array.from(blockAt.keys()).pop();
      blockAt.delete(last);
    }
    renderBlocks();
  }

  function refillFogGoal() {
    const g = state.goal;
    if (!g || g.type !== 'fog' || goalDone()) return;
    if (coverAt.size) return;
    const n = Math.min(4, g.need - g.got);
    if (n > 0) {
      spawnCovers('fog', n);
      toast('雾又聚回来一些');
    }
  }

  function setupWeather(level, silent) {
    const fogGoal = state.goal && state.goal.type === 'fog';
    let picked = weatherFor(level);
    if (state.mode === 'daily') picked = WEATHER_SEQ[Math.abs(hashStr('xiaoyuan-daily-weather-' + todayKey())) % WEATHER_SEQ.length];
    if (state.mode === 'story') {
      const info = chapterInfo(level);
      if (info.def.weather) picked = info.def.weather;
    }
    if (state.mode === 'zen' || state.mode === 'challenge') picked = 'sunny';
    else if (state.mode === 'score') picked = WEATHER_SEQ[Math.floor(Math.random() * WEATHER_SEQ.length)];
    state.weather = fogGoal ? 'fog' : picked;
    state.weatherMoves = 0;
    document.body.setAttribute('data-weather', state.weather);
    coverAt.clear();
    renderCovers();
    updateWeatherChip();
    if (fogGoal) spawnCovers('fog', Math.min(5, state.goal.need));
    else if (state.weather === 'rain') spawnCovers('rain', 3);
    else if (state.weather === 'fog') spawnCovers('fog', 7);
    else if (state.weather === 'leaf') spawnCovers('leaf', 2, 'bottom');
    if (!silent) {
      const meta = WEATHER_META[state.weather];
      toast(meta.name + ' · ' + meta.rule);
    }
  }

  function updateWeatherChip() {
    const meta = WEATHER_META[state.weather] || WEATHER_META.sunny;
    weatherIconEl.innerHTML = meta.icon;
    weatherNameEl.textContent = meta.name;
  }

  function applySeasonRule() {
    state.seasonTicks = (state.seasonTicks || 0) + 1;
    const se = seasonKey();
    const tick = state.seasonTicks;
    if (se === 'spring' && tick % 5 === 0) {
      addScore(50);
      toast('春日花开 · +50');
    } else if (se === 'summer' && tick % 4 === 0) {
      if (coverAt.size < 10) spawnCovers('rain', 1);
    } else if (se === 'autumn' && tick % 3 === 0) {
      if (coverAt.size < 10) spawnCovers('leaf', 2, 'bottom');
    } else if (se === 'winter' && tick % 4 === 0) {
      if (blockAt.size < 10) spawnBlocks(1, 'ice');
    }
  }

  function afterMoveWeather() {
    applySeasonRule();
    state.weatherMoves++;
    const cap = 9;
    if (state.weather === 'rain' && state.weatherMoves % 2 === 0 && coverAt.size < cap) {
      spawnCovers('rain', 1);
    } else if (state.weather === 'leaf' && state.weatherMoves % 3 === 0 && coverAt.size < cap) {
      spawnCovers('leaf', 2, 'bottom');
    }
  }

  /* ============================================================
     洗牌
     ============================================================ */
  function shuffleArray(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(rnd() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
  }

  async function shuffleBoard(auto) {
    const plain = [];
    const types = [];
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const t = grid[r][c];
        if (t && t.type !== 'rainbow') {
          plain.push(t);
          types.push(t.type);
        }
      }
    }

    if (coverAt.size && !(state.goal && state.goal.type === 'fog')) {
      coverAt.clear();
      renderCovers();
    }

    boardEl.classList.add('shuffling');
    playShuffle();
    await sleep(220);

    let ok = false;
    for (let attempt = 0; attempt < 16 && !ok; attempt++) {
      shuffleArray(types);
      for (let i = 0; i < plain.length; i++) {
        plain[i].type = types[i];
        renderArt(plain[i]);
      }
      ok = findRuns().length === 0 && hasValidMove();
    }

    if (!ok) {
      for (let attempt = 0; attempt < 30 && !ok; attempt++) {
        for (const t of plain) {
          t.type = randomType();
          renderArt(t);
        }
        ok = findRuns().length === 0 && hasValidMove();
      }
    }

    boardEl.classList.remove('shuffling');
    await sleep(160);
    if (auto) toast('没有可消的组合，重新洗牌');
  }

  /* ============================================================
     关卡流程与结算
     ============================================================ */
  function prepareRun() {
    state.inCourt = false;
    state.lantern = 0;
    state.lanternTicks = 0;
    state.courtReady = false;
    state.busy = false;
    state.paused = false;
    state.over = false;
    overlay.hidden = true;
    document.body.classList.remove('sheet-open');
    clearHint();
    clearSelection();
    selected = null;
    blockAt.clear();
    renderBlocks();
  }

  function renderLevelChip() {
    if (state.mode === 'weekly') {
      lvPrefixEl.textContent = '';
      levelEl.textContent = '周赛';
      lvSuffixEl.textContent = '';
    } else if (state.mode === 'daily') {
      lvPrefixEl.textContent = '每日';
      levelEl.textContent = String(loadDaily().left);
      lvSuffixEl.textContent = '次';
    } else if (state.mode === 'score') {
      lvPrefixEl.textContent = '';
      levelEl.textContent = '冲分';
      lvSuffixEl.textContent = '';
    } else if (state.mode === 'zen') {
      lvPrefixEl.textContent = '';
      levelEl.textContent = '禅意';
      lvSuffixEl.textContent = '';
    } else if (state.mode === 'challenge') {
      lvPrefixEl.textContent = '';
      levelEl.textContent = '清障';
      lvSuffixEl.textContent = '';
    } else {
      const info = chapterInfo(state.level);
      lvPrefixEl.textContent = '第' + info.chapter + '章';
      levelEl.textContent = String(info.inChapter);
      lvSuffixEl.textContent = '/' + CHAPTER_LEN;
    }
    renderChapterLine();
  }

  function renderChapterLine() {
    if (!chapterNameEl) return;
    if (state.mode === 'daily') { chapterNameEl.textContent = '每日一盘'; return; }
    if (state.mode === 'weekly') { chapterNameEl.textContent = '本周同盘'; return; }
    if (state.mode === 'score') { chapterNameEl.textContent = '限步冲分'; return; }
    if (state.mode === 'zen') { chapterNameEl.textContent = '禅意小院'; return; }
    if (state.mode === 'challenge') { chapterNameEl.textContent = '清障挑战'; return; }
    const info = chapterInfo(state.level);
    chapterNameEl.textContent = '第' + info.chapter + '章 · ' + info.def.short;
  }

  function startLevel(level, silent) {
    syncSeason();
    state.seasonTicks = 0;
    unseedRng();
    state.mode = 'story';
    state.storyLevel = level;
    state.level = level;
    state.types = typesForStory(level);
    state.moves = movesFor(level);
    state.goal = goalFor(level);
    writeStore(STORY_KEY, level);
    state.basketType = basketTypeFor(level);
    state.levelStart = state.score;
    prepareRun();
    buildBoard();
    setupWeather(level, silent);
    setupObstacles(level);
    updateLantern();
    renderLevelChip();
    updateHud();
    syncTabs();
    scheduleHint();
    const info = chapterInfo(level);
    if (info.inChapter === 1 && level > 1 && !silent) {
      setTimeout(() => toast('第' + info.chapter + '章 · ' + info.def.name + '：' + info.def.note), 1100);
    }
  }

  function startDailyRun(rec) {
    seedRng(hashStr('xiaoyuan-daily-' + todayKey()));
    state.mode = 'daily';
    state.level = 1;
    state.score = 0;
    state.levelStart = 0;
    state.moves = START_MOVES;
    state.types = DAILY_TYPES;
    const idx = dayIndex();
    state.basketType = state.types[idx % state.types.length];
    state.goal = { type: 'basket', need: 12, got: 0 };
    prepareRun();
    buildBoard();
    setupWeather(1, true);
    setupObstacles(1);
    updateLantern();
    renderLevelChip();
    updateHud();
    syncTabs();
    scheduleHint();
    toast('每日一关 · 今天同一盘，还剩 ' + rec.left + ' 次');
  }

  function updateHud(bump) {
    scoreEl.textContent = state.score.toLocaleString('zh-CN');
    if (state.mode === 'zen') {
      movesEl.textContent = '∞';
      movesEl.classList.remove('low');
    } else {
      movesEl.textContent = Math.max(0, state.moves);
      movesEl.classList.toggle('low', state.moves <= 5);
    }
    updateGoalUi();

    if (bump) {
      scoreEl.classList.remove('bump');
      void scoreEl.offsetWidth;
      scoreEl.classList.add('bump');
    }
  }

  function getBest() {
    try {
      const v = Number(localStorage.getItem(BEST_KEY) || 0);
      return Number.isFinite(v) ? v : 0;
    } catch (err) { return 0; }
  }

  function saveBest() {
    const best = Math.max(getBest(), state.score);
    try { localStorage.setItem(BEST_KEY, String(best)); } catch (err) { /* 忽略 */ }
    if (bestValEl) bestValEl.textContent = best.toLocaleString('zh-CN');
    return best;
  }

  function refreshBest() {
    if (bestValEl) bestValEl.textContent = getBest().toLocaleString('zh-CN');
  }

  function openSheet(opt) {
    closeThemePop();
    sheetStarsEl.hidden = true;
    sheetStarTipEl.hidden = true;
    sheetToolsEl.hidden = true;
    sheetStatsEl.style.display = opt.hideStats ? 'none' : '';
    sheetKicker.textContent = opt.kicker;
    sheetTitle.textContent = opt.title;
    sheetBody.textContent = opt.body;
    sheetScore.textContent = (opt.score || 0).toLocaleString('zh-CN');
    sheetBest.textContent = (opt.best || 0).toLocaleString('zh-CN');
    if (opt.stars) setSheetStars(opt.stars, opt.starTip || '');
    sheetBtn.textContent = opt.btn;
    sheetBtn.onclick = () => {
      overlay.hidden = true;
      state.paused = false;
      document.body.classList.remove('sheet-open');
      if (typeof opt.action === 'function') opt.action();
    };
    overlay.hidden = false;
    state.paused = true;
    document.body.classList.add('sheet-open');
    playChime(opt.kind || 'level');
    overlay.querySelector('.sheet').setAttribute('tabindex', '-1');
  }

  function maybeShowGuide() {
    if (readStore(GUIDE_KEY, false)) return;
    writeStore(GUIDE_KEY, true);
    setTimeout(() => {
      if (state.page || !overlay.hidden) return;
      openSheet({
        kicker: '第一次来小院',
        title: '三步学会摘果',
        body: '① 点选或拖动相邻两颗，横竖凑成三个。\n② 完成上方目标就过关；余步≥4 得 2★，分数达标得 3★。\n③ 门廊灯每 3 次消除亮一盏，三盏齐亮会收走场上最多的一种果子。',
        btn: '开始摘果',
        hideStats: true,
        kind: 'guide'
      });
    }, 550);
  }

  function starTargetNow() {
    return state.mode === 'daily' ? 1800 : starTargetFor(state.level);
  }

  function computeStars() {
    let stars = 1;
    if (state.moves >= 4) stars = 2;
    if (stars >= 2 && levelScore() >= starTargetNow()) stars = 3;
    return stars;
  }

  function goalRestText() {
    const g = state.goal;
    const gap = Math.max(0, g.need - g.got);
    if (g.type === 'basket') return '还差 ' + gap + ' 个' + (TYPE_NAMES[state.basketType] || state.basketType);
    if (g.type === 'fog') return '还差 ' + gap + ' 格雾气';
    if (g.type === 'lantern') return '还差 ' + gap + ' 次满院灯火';
    if (g.type === 'clear') return '还差 ' + gap + ' 处障碍';
    if (g.type === 'order') return '订单还差 ' + g.parts.filter((p) => p.got < p.need).map((p) => (TYPE_NAMES[p.t] || p.t) + ' ' + (p.need - p.got)).join('、');
    return '还差 ' + gap + ' 次连击';
  }

  function goalDoneTitle() {
    const g = state.goal;
    if (g.type === 'basket') return '这一篮收满了';
    if (g.type === 'fog') return '院子里的雾散了';
    if (g.type === 'lantern') return '门廊灯火亮透了';
    if (g.type === 'clear') return '小院清清爽爽';
    if (g.type === 'order') return '订单交货了';
    return '这一串连得漂亮';
  }

  function setSheetStars(n, tip) {
    sheetStarsEl.hidden = false;
    sheetStarsEl.querySelectorAll('svg').forEach((el, i) => el.classList.toggle('on', i < n));
    sheetStarTipEl.hidden = false;
    sheetStarTipEl.textContent = tip;
  }

  function showLevelSheet() {
    stopHintTimer();
    clearHint();
    const g = state.goal;
    const left = Math.max(0, state.moves);
    const extra = left * 40;
    const runScore = state.score;
    if (extra) state.score += extra;
    updateHud();

    if (state.mode === 'challenge') {
      const best = saveModeBest(CLEAR_BEST_KEY, state.score);
      state.runBest = best;
      openSheet({
        kind: 'level',
        kicker: '清障挑战 · 完成',
        title: '院子清出来了',
        body: CHALLENGE_MOVES + ' 步清了 ' + g.need + ' 处障碍，收 ' + state.score.toLocaleString('zh-CN') + ' 分。',
        score: state.score,
        best,
        btn: '再来一局',
        action: startChallenge
      });
      return;
    }
    if (state.mode === 'daily') {
      const stars = computeStars();
      const rec = loadDaily();
      rec.done = true;
      rec.best = Math.max(rec.best, state.score);
      rec.stars = Math.max(rec.stars, stars);
      saveDaily(rec);
      addOil(2);
      saveBest();
      openSheet({
        kind: 'level',
        kicker: '每日一关 · 今日完成',
        title: '今天的院子收满了',
        body: '用 ' + left + ' 步收满 ' + g.need + ' 个' + (TYPE_NAMES[state.basketType] || '')
          + (extra ? '，余步折 ' + extra + ' 分' : '') + '。奖励 2 灯油，明天换新盘。',
        score: state.score,
        best: rec.best,
        btn: '回小院',
        stars,
        starTip: '今日最好 ' + rec.best.toLocaleString('zh-CN') + ' 分 · ' + rec.stars + ' 星',
        action: exitDaily
      });
      return;
    }

    const stars = computeStars();
    saveStars(state.level, stars);
    const oilGain = stars === 3 ? 2 : 1;
    addOil(oilGain);
    saveBest();
    const next = state.level + 1;
    openSheet({
      kind: 'level',
      kicker: '第' + chapterInfo(state.level).chapter + '章 '
        + chapterInfo(state.level).inChapter + '/' + CHAPTER_LEN + ' · ' + (GOAL_NAMES[g.type] || '目标'),
      title: goalDoneTitle(),
      body: '用 ' + left + ' 步完成目标，余下步数折 ' + (extra || 0) + ' 分。'
        + (stars < 3 ? '再省几步、多攒点分，能拿更多星。' : '三星漂亮。'),
      score: state.score,
      best: saveBest(),
      btn: '进入第 ' + next + ' 关',
      stars,
      starTip: '本关最佳 ' + starsFor(state.level) + ' 星 · 灯油 +' + oilGain,
      action: () => startLevel(next)
    });
  }

  function showOverSheet() {
    state.over = true;
    stopHintTimer();
    clearHint();
    if (state.mode === 'weekly') {
      const rec = loadWeek();
      rec.best = Math.max(rec.best, state.score);
      saveWeek(rec);
      state.weekBest = rec.best;
      state.runBest = rec.best;
      saveBest();
      openSheet({
        kind: 'over',
        kicker: '本周棋局 · 结束',
        title: rec.best > state.score ? '本周最好还差一点' : '本周新纪录',
        body: START_MOVES + ' 步收了 ' + state.score.toLocaleString('zh-CN') + ' 分，本周最好 '
          + rec.best.toLocaleString('zh-CN') + ' 分。这一周内可以再来。',
        score: state.score,
        best: rec.best,
        btn: '再来一局',
        action: startWeekly
      });
      return;
    }
    if (state.mode === 'score') {
      const best = saveModeBest(SCORE_BEST_KEY, state.score);
      state.runBest = best;
      openSheet({
        kind: 'over',
        kicker: '限步冲分 · 结束',
        title: best > state.score ? '再冲一分就破纪录' : '这一盘新高',
        body: SCORE_MOVES + ' 步收了 ' + state.score.toLocaleString('zh-CN') + ' 分，最好 '
          + best.toLocaleString('zh-CN') + ' 分。',
        score: state.score,
        best,
        btn: '再来一局',
        action: startScoreRun
      });
      return;
    }
    if (state.mode === 'challenge') {
      const best = saveModeBest(CLEAR_BEST_KEY, state.score);
      state.runBest = best;
      openSheet({
        kind: 'over',
        kicker: '清障挑战 · 结束',
        title: '还差一点',
        body: goalRestText() + '。' + CHALLENGE_MOVES + ' 步再来一次。',
        score: state.score,
        best,
        btn: '再试一局',
        action: startChallenge
      });
      return;
    }
    if (state.mode === 'daily') {
      const rec = loadDaily();
      rec.best = Math.max(rec.best, state.score);
      saveDaily(rec);
      saveBest();
      openSheet({
        kind: 'over',
        kicker: '每日一关 · 今日结束',
        title: '今天差一点',
        body: goalRestText() + '。今天的机会用完了，明早换一盘新的。',
        score: state.score,
        best: rec.best,
        btn: '回小院',
        action: exitDaily
      });
      return;
    }
    const loseInfo = chapterInfo(state.level);
    openSheet({
      kind: 'over',
      kicker: '第' + loseInfo.chapter + '章 ' + loseInfo.inChapter + '/' + CHAPTER_LEN + ' · 步数用完了',
      title: '这一关差一点',
      body: goalRestText() + '。再试一次，手气也许就顺了。',
      score: state.score,
      best: saveBest(),
      btn: '再试这一关',
      action: () => retryLevel(false)
    });
  }

  function resetGame(announce) {
    stopHintTimer();
    clearHint();
    clearSelection();
    overlay.hidden = true;
    document.body.classList.remove('sheet-open');
    drag = null;
    state.score = 0;
    startLevel(1, true);
    refreshBest();
    if (announce) toast('重新开局');
  }

  function retryLevel(announce) {
    stopHintTimer();
    clearHint();
    clearSelection();
    drag = null;
    state.score = state.levelStart || 0;
    startLevel(state.level || 1, true);
    refreshBest();
    if (announce) toast('重开这一关');
  }

  /* ---------- 小院周赛 ---------- */
  function startWeekly() {
    ensureAudio();
    if (state.busy) return;
    if (state.mode === 'story') {
      state.storyLevel = state.level || 1;
      state.storyScore = state.score || 0;
    }
    const rec = loadWeek();
    rec.plays = (rec.plays || 0) + 1;
    saveWeek(rec);
    state.weekBest = rec.best;
    state.runBest = rec.best;
    seedRng(hashStr('xiaoyuan-week-' + rec.key));
    state.mode = 'weekly';
    state.level = 1;
    state.score = 0;
    state.levelStart = 0;
    state.moves = START_MOVES;
    state.seasonTicks = 0;
    state.types = WEEK_TYPES;
    state.basketType = 'peach';
    state.goal = { type: 'score', need: 1, got: 0 };
    prepareRun();
    buildBoard();
    setupWeather(1, true);
    setupObstacles(1);
    updateLantern();
    renderLevelChip();
    updateHud();
    syncTabs();
    scheduleHint();
    toast('本周棋局 · 24 步冲分');
  }

  function exitWeekly() {
    if (state.mode !== 'weekly') return;
    state.mode = 'story';
    state.score = state.storyScore || 0;
    startLevel(state.storyLevel || 1, true);
  }

