  /* ============================================================
     棋盘生成
     ============================================================ */
  function randomType() {
    const pool = state.types && state.types.length ? state.types : CORE_TYPES;
    return pool[Math.floor(rnd() * pool.length)];
  }

  function buildBoard() {
    for (let attempt = 0; attempt < 40; attempt++) {
      boardEl.innerHTML = '';
      grid = Array.from({ length: ROWS }, () => Array(COLS).fill(null));

      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const banned = new Set();
          if (c >= 2 && grid[r][c - 1].type === grid[r][c - 2].type) banned.add(grid[r][c - 1].type);
          if (r >= 2 && grid[r - 1][c].type === grid[r - 2][c].type) banned.add(grid[r - 1][c].type);
          let type = randomType();
          let guard = 0;
          while (banned.has(type) && guard++ < 24) type = randomType();
          grid[r][c] = createTile(type, r, c);
        }
      }

      if (hasValidMove()) return;
    }
  }

  /* ============================================================
     匹配检测
     ============================================================ */
  function findRuns() {
    const runs = [];

    for (let r = 0; r < ROWS; r++) {
      let start = 0;
      for (let c = 1; c <= COLS; c++) {
        const prev = grid[r][c - 1];
        const cur = c < COLS ? grid[r][c] : null;
        const same = !!cur && !!prev && prev.type !== 'rainbow' && cur.type === prev.type;
        if (!same) {
          if (prev && prev.type !== 'rainbow' && c - start >= 3) {
            const cells = [];
            for (let cc = start; cc < c; cc++) cells.push({ r, c: cc });
            runs.push({ dir: 'h', type: prev.type, cells });
          }
          start = c;
        }
      }
    }

    for (let c = 0; c < COLS; c++) {
      let start = 0;
      for (let r = 1; r <= ROWS; r++) {
        const prev = grid[r - 1][c];
        const cur = r < ROWS ? grid[r][c] : null;
        const same = !!cur && !!prev && prev.type !== 'rainbow' && cur.type === prev.type;
        if (!same) {
          if (prev && prev.type !== 'rainbow' && r - start >= 3) {
            const cells = [];
            for (let rr = start; rr < r; rr++) cells.push({ r: rr, c });
            runs.push({ dir: 'v', type: prev.type, cells });
          }
          start = r;
        }
      }
    }

    return runs;
  }

  function buildClusters() {
    const runs = findRuns();
    if (!runs.length) return null;

    const matched = new Map();
    for (const run of runs) {
      for (const cell of run.cells) matched.set(keyOf(cell.r, cell.c), run.type);
    }

    const seen = new Set();
    const clusters = [];

    for (const [k, type] of matched) {
      if (seen.has(k)) continue;
      const cells = [];
      const queue = [k];
      seen.add(k);

      while (queue.length) {
        const cur = queue.pop();
        const [r, c] = parseKey(cur);
        cells.push({ r, c });
        for (const [dr, dc] of DIRS) {
          const nr = r + dr, nc = c + dc;
          const nk = keyOf(nr, nc);
          if (matched.get(nk) === type && !seen.has(nk)) {
            seen.add(nk);
            queue.push(nk);
          }
        }
      }
      clusters.push({ type, cells, size: cells.length });
    }
    return clusters;
  }

  function createsMatch(r1, c1, r2, c2) {
    const a = grid[r1][c1];
    const b = grid[r2][c2];
    if (!a || !b) return false;
    if (a.type === 'rainbow' || b.type === 'rainbow') return true;
    const ta = a.type, tb = b.type;
    a.type = tb;
    b.type = ta;
    const ok = findRuns().length > 0;
    a.type = ta;
    b.type = tb;
    return ok;
  }

  function findValidPair() {
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (!grid[r][c] || isBlockedKey(keyOf(r, c))) continue;
        if (c + 1 < COLS && !isBlockedKey(keyOf(r, c + 1)) && createsMatch(r, c, r, c + 1)) {
          return [grid[r][c], grid[r][c + 1]];
        }
        if (r + 1 < ROWS && !isBlockedKey(keyOf(r + 1, c)) && createsMatch(r, c, r + 1, c)) {
          return [grid[r][c], grid[r + 1][c]];
        }
      }
    }
    return null;
  }

  function hasValidMove() {
    return !!findValidPair();
  }

  /* ============================================================
     特殊棋子：消除扩散
     ============================================================ */
  function expandSpecials(cells) {
    const done = new Set();
    let changed = true;

    while (changed) {
      changed = false;
      for (const k of Array.from(cells)) {
        if (done.has(k)) continue;
        done.add(k);
        const [r, c] = parseKey(k);
        const t = grid[r][c];
        if (!t || t.special !== 'bomb') continue;

        for (let dr = -1; dr <= 1; dr++) {
          for (let dc = -1; dc <= 1; dc++) {
            const nr = r + dr, nc = c + dc;
            if (nr < 0 || nr >= ROWS || nc < 0 || nc >= COLS) continue;
            const nk = keyOf(nr, nc);
            if (!cells.has(nk)) {
              cells.add(nk);
              changed = true;
            }
          }
        }
      }
    }
  }

  function pickSpecialCell(cluster, swapPair) {
    if (swapPair) {
      for (const p of swapPair) {
        if (cluster.cells.some((cell) => cell.r === p.r && cell.c === p.c)) return p;
      }
    }
    let best = null;
    let bestDist = Infinity;
    const avgC = cluster.cells.reduce((s, cell) => s + cell.c, 0) / cluster.cells.length;
    const avgR = cluster.cells.reduce((s, cell) => s + cell.r, 0) / cluster.cells.length;
    for (const cell of cluster.cells) {
      const d = Math.abs(cell.c - avgC) + Math.abs(cell.r - avgR);
      if (d < bestDist) {
        bestDist = d;
        best = cell;
      }
    }
    return best;
  }

  /* ============================================================
     下落与补充
     ============================================================ */
  async function dropAndFill() {
    const moves = [];
    let maxDist = 1;

    boardEl.classList.add('no-anim');

    for (let c = 0; c < COLS; c++) {
      let write = ROWS - 1;

      for (let r = ROWS - 1; r >= 0; r--) {
        const t = grid[r][c];
        if (!t) continue;
        if (r !== write) {
          grid[write][c] = t;
          grid[r][c] = null;
          maxDist = Math.max(maxDist, write - r);
          moves.push({ t, r: write, c });
        }
        write--;
      }

      const holes = write + 1;
      for (let r = 0; r <= write; r++) {
        const t = createTile(randomType(), r, c, null, r - holes);
        grid[r][c] = t;
        maxDist = Math.max(maxDist, holes);
        moves.push({ t, r, c });
      }
    }

    void boardEl.offsetHeight;
    boardEl.classList.remove('no-anim');

    for (const m of moves) setPos(m.t, m.r, m.c);
    await sleep(Math.min(320, 190 + maxDist * 22));
  }

  /* ============================================================
     消除与连锁
     ============================================================ */
  async function resolve(initialCells, swapPair) {
    let chain = 0;
    let maxChain = 0;
    let cells = initialCells;
    const pending = [];
    const applied = new Set();

    while (true) {
      let clusters = null;

      if (!cells) {
        clusters = buildClusters();
        if (!clusters) break;
        cells = new Set();
        for (const cl of clusters) {
          for (const cell of cl.cells) cells.add(keyOf(cell.r, cell.c));
        }
      }

      chain++;
      if (chain > maxChain) maxChain = chain;
      const createdNow = [];
      let createdCount = 0;

      if (clusters) {
        for (const cl of clusters) {
          if (cl.size < 4) continue;
          const loc = pickSpecialCell(cl, swapPair);
          if (!loc) continue;
          if (pending.some((p) => p.r === loc.r && p.c === loc.c)) continue;
          pending.push({ r: loc.r, c: loc.c, special: cl.size >= 5 ? 'rainbow' : 'bomb' });
          createdNow.push(loc);
          createdCount++;
        }
        swapPair = null;
      }

      expandSpecials(cells);
      for (const loc of createdNow) cells.delete(keyOf(loc.r, loc.c));
      if (!cells.size) break;

      countGoal(cells);
      countCollection(cells);
      dissolveCovers(cells);
      dissolveBlocks(cells);
      tickLantern();

      const gained = cells.size * 10 * chain + createdCount * 80;
      addScore(gained);
      floatScore(cells, gained);
      burst(cells);
      playPop(chain);
      if (chain >= 2) showCombo(chain);

      for (const k of cells) {
        const [r, c] = parseKey(k);
        const t = grid[r][c];
        if (t) t.el.classList.add('pop');
      }

      await sleep(200);

      for (const k of cells) {
        const [r, c] = parseKey(k);
        const t = grid[r][c];
        if (t) {
          t.el.remove();
          grid[r][c] = null;
        }
      }

      await dropAndFill();

      for (const p of pending) {
        if (applied.has(keyOf(p.r, p.c))) continue;
        applied.add(keyOf(p.r, p.c));
        const t = grid[p.r][p.c];
        if (t && !t.special) {
          t.special = p.special;
          if (p.special === 'rainbow') {
            t.type = 'rainbow';
            if (!state.saidRainbow) {
              state.saidRainbow = true;
              toast('五个连成线，得到一颗「彩虹果」');
            }
          } else if (!state.saidBomb) {
            state.saidBomb = true;
            toast('四个连成线，攒出一颗「爆果」');
          }
          renderArt(t);
          t.el.classList.add('birth');
          setTimeout(() => t.el.classList.remove('birth'), 540);
        }
      }

      cells = null;
      if (chain >= 14) break;
    }

    if (!state.inCourt && state.goal && state.goal.type === 'combo' && maxChain >= 2) {
      state.goal.got = Math.min(state.goal.need, state.goal.got + 1);
      updateGoalUi();
    }

    updateHud();

    if (!hasValidMove()) await shuffleBoard(true);
  }

  /* ============================================================
     分数、特效
     ============================================================ */
  function addScore(n) {
    state.score += n;
    updateHud(true);
  }

  function floatScore(cells, gained) {
    let sr = 0, sc = 0, n = 0;
    for (const k of cells) {
      const [r, c] = parseKey(k);
      sr += r;
      sc += c;
      n++;
    }
    if (!n) return;
    const el = document.createElement('div');
    el.className = 'float';
    el.textContent = '+' + gained;
    el.style.left = ((sc / n + 0.5) * 12.5).toFixed(2) + '%';
    el.style.top = ((sr / n + 0.5) * 12.5).toFixed(2) + '%';
    fxEl.appendChild(el);
    setTimeout(() => el.remove(), 920);
  }

  function burst(cells) {
    let count = 0;
    for (const k of cells) {
      if (count >= 28) break;
      const [r, c] = parseKey(k);
      const t = grid[r][c];
      if (!t) continue;
      const color = TYPE_COLORS[t.type] || '#F6DCA0';
      for (let i = 0; i < 2 && count < 32; i++) {
        count++;
        const p = document.createElement('span');
        p.className = 'pt';
        p.style.left = ((c + 0.5) * 12.5).toFixed(2) + '%';
        p.style.top = ((r + 0.5) * 12.5).toFixed(2) + '%';
        p.style.background = color;
        const ang = rnd() * Math.PI * 2;
        const dist = 20 + rnd() * 34;
        p.style.setProperty('--dx', (Math.cos(ang) * dist).toFixed(1) + 'px');
        p.style.setProperty('--dy', (Math.sin(ang) * dist).toFixed(1) + 'px');
        fxEl.appendChild(p);
        setTimeout(() => p.remove(), 780);
      }
    }
  }

  function showCombo(chain) {
    comboEl.textContent = chain >= 4 ? '连击 ×' + chain + '　漂亮' : '连击 ×' + chain;
    comboEl.classList.remove('show');
    void comboEl.offsetWidth;
    comboEl.classList.add('show');
  }

  /* ============================================================
     一次交换
     ============================================================ */
  function endTurn() {
    if (state.mode === 'zen') {
      scheduleHint();
      return;
    }
    if (goalDone()) {
      showLevelSheet();
      return;
    }
    if (state.moves <= 0) {
      showOverSheet();
      return;
    }
    refillFogGoal();
    afterMoveWeather();
    scheduleHint();
  }

  async function attemptSwap(a, b) {
    if (state.busy || state.paused || state.over) return;
    if (!onBoard(a) || !onBoard(b)) return;
    if (Math.abs(a.r - b.r) + Math.abs(a.c - b.c) !== 1) return;

    const blockedKey = isBlockedKey(keyOf(a.r, a.c)) ? keyOf(a.r, a.c) : (isBlockedKey(keyOf(b.r, b.c)) ? keyOf(b.r, b.c) : null);
    if (blockedKey) {
      nudge();
      const [br, bc] = parseKey(blockedKey);
      toast(blockAt.has(blockedKey) ? blockTip(blockAt.get(blockedKey)) : coverTip(coverAt.get(blockedKey)));
      return;
    }

    clearSelection();
    clearHint();
    stopHintTimer();

    state.busy = true;
    playSwap();
    swapData(a, b);
    await sleep(235);

    const pair = [{ r: a.r, c: a.c }, { r: b.r, c: b.c }];
    let cells = null;
    const rainbowSwap = a.type === 'rainbow' || b.type === 'rainbow';

    const bombPair = a.special === 'bomb' && b.special === 'bomb';
    if (bombPair) {
      cells = new Set();
      for (const p of [a, b]) {
        for (let dr = -2; dr <= 2; dr++) {
          for (let dc = -2; dc <= 2; dc++) {
            const rr = p.r + dr, cc = p.c + dc;
            if (rr >= 0 && rr < ROWS && cc >= 0 && cc < COLS) cells.add(keyOf(rr, cc));
          }
        }
      }
      toast('爆果碰爆果，整片炸开了');
    } else if ((a.type === 'rainbow' && b.special === 'bomb') || (b.type === 'rainbow' && a.special === 'bomb')) {
      cells = new Set();
      const bomb = a.special === 'bomb' ? a : b;
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const t = grid[r][c];
          if (t && t.type === bomb.type) cells.add(keyOf(r, c));
        }
      }
      for (let dr = -2; dr <= 2; dr++) {
        for (let dc = -2; dc <= 2; dc++) {
          const rr = bomb.r + dr, cc = bomb.c + dc;
          if (rr >= 0 && rr < ROWS && cc >= 0 && cc < COLS) cells.add(keyOf(rr, cc));
        }
      }
      toast('彩虹果裹住爆果，整色都亮了');
    } else if (rainbowSwap) {
      cells = new Set();
      if (a.type === 'rainbow' && b.type === 'rainbow') {
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) if (grid[r][c]) cells.add(keyOf(r, c));
        }
      } else {
        const rainbowTile = a.type === 'rainbow' ? a : b;
        const other = rainbowTile === a ? b : a;
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            const t = grid[r][c];
            if (t && t.type === other.type) cells.add(keyOf(r, c));
          }
        }
        cells.add(keyOf(rainbowTile.r, rainbowTile.c));
      }
    } else if (!findRuns().length) {
      playInvalid();
      swapData(a, b);
      boardEl.classList.add('shake');
      await sleep(320);
      boardEl.classList.remove('shake');
      state.busy = false;
      scheduleHint();
      return;
    }

    state.moves--;
    updateHud();
    await resolve(cells, pair);
    let courts = 0;
    while (state.courtReady && courts++ < 2) await fullCourt();
    state.busy = false;
    endTurn();
  }

  function nudge() {
    boardEl.classList.remove('shake');
    void boardEl.offsetWidth;
    boardEl.classList.add('shake');
    setTimeout(() => boardEl.classList.remove('shake'), 340);
  }

  /* ============================================================
     输入
     ============================================================ */
  function selectTile(t) {
    if (!onBoard(t)) return;
    if (isBlockedKey(keyOf(t.r, t.c))) {
      const bk = keyOf(t.r, t.c);
      toast(blockAt.has(bk) ? blockTip(blockAt.get(bk)) : coverTip(coverAt.get(bk)));
      return;
    }
    if (selected === t) {
      clearSelection();
      return;
    }
    if (selected && onBoard(selected)) {
      const dist = Math.abs(selected.r - t.r) + Math.abs(selected.c - t.c);
      if (dist === 1) {
        const a = selected;
        clearSelection();
        attemptSwap(a, t);
        return;
      }
    }
    clearSelection();
    selected = t;
    t.el.classList.add('sel');
  }

  function clearSelection() {
    if (selected) {
      if (selected.el) selected.el.classList.remove('sel');
      selected = null;
    }
  }

  boardEl.addEventListener('pointerdown', (e) => {
    if (state.busy || state.paused || state.over) return;
    ensureAudio();
    const el = e.target.closest && e.target.closest('.tile');
    if (!el || !el.__tile) return;
    clearHint();
    drag = { t: el.__tile, x: e.clientX, y: e.clientY, id: e.pointerId };
    try {
      boardEl.setPointerCapture(e.pointerId);
    } catch (err) { /* 忽略 */ }
    e.preventDefault();
  });

  boardEl.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.x;
    const dy = e.clientY - drag.y;
    if (Math.hypot(dx, dy) < 24) return;

    const horizontal = Math.abs(dx) >= Math.abs(dy);
    const dc = horizontal ? (dx > 0 ? 1 : -1) : 0;
    const dr = horizontal ? 0 : (dy > 0 ? 1 : -1);
    const t = drag.t;
    drag = null;

    const nr = t.r + dr;
    const nc = t.c + dc;
    if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && grid[nr][nc]) {
      attemptSwap(t, grid[nr][nc]);
    } else {
      nudge();
    }
  });

  boardEl.addEventListener('pointerup', () => {
    if (!drag) return;
    const t = drag.t;
    drag = null;
    selectTile(t);
  });

  boardEl.addEventListener('pointercancel', () => { drag = null; });

