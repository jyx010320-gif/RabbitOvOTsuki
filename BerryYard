    ensureAudio();
    if (state.busy) return;
    rememberStory();
    state.mode = 'score';
    state.level = 1;
    state.score = 0;
    state.levelStart = 0;
    state.moves = SCORE_MOVES;
    state.seasonTicks = 0;
    state.types = SCORE_TYPES;
    state.basketType = 'peach';
    state.runBest = loadModeBest(SCORE_BEST_KEY);
    state.goal = { type: 'score', need: 1, got: 0 };
    prepareRun();
    buildBoard();
    setupWeather(1, true);
    setupObstacles(1);
    updateLantern();
    renderLevelChip();
    updateHud();
    syncTabs();
    scheduleHint();
    toast('限步冲分 · ' + SCORE_MOVES + ' 步，尽量多收');
  }

