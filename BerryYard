/* ============ 换色控件 ============ */
.theme-dock{position:fixed;top:14px;right:14px;z-index:55;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.theme-btn{
  appearance:none;cursor:pointer;
  display:inline-flex;align-items:center;gap:6px;
  min-height:38px;padding:7px 13px 7px 11px;
  border-radius:999px;
  border:1px solid var(--btn-line);
  background:var(--btn-bg);
  color:var(--btn-fg);
  font-family:inherit;font-size:12px;letter-spacing:.08em;
  transition:background .16s ease,border-color .16s ease,color .16s ease,transform .1s ease;
}
.theme-btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round}
.theme-btn:hover{background:var(--btn-bg-hover);border-color:var(--frame-line-strong);color:var(--btn-fg-hover)}
.theme-btn:active{transform:translateY(1px)}
.theme-btn:focus-visible{outline:1px solid var(--accent);outline-offset:3px}
.theme-pop{
  width:214px;padding:13px 12px 11px;
  border-radius:16px;
  background:linear-gradient(180deg,var(--sheet-a),var(--sheet-b));
  border:1px solid var(--sheet-line);
  box-shadow:0 22px 48px -18px rgba(0,0,0,.7);
  animation:fadeIn .18s ease;
}
.theme-pop[hidden]{display:none}
.theme-pop-title{margin:0 0 9px 4px;font-size:11px;letter-spacing:.16em;color:var(--muted)}
.theme-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.theme-item{
  appearance:none;cursor:pointer;width:100%;
  display:flex;align-items:center;gap:6px;
  min-height:40px;padding:7px 7px;border-radius:10px;
  border:1px solid transparent;background:transparent;
  color:var(--ink-soft);font-family:inherit;font-size:12.5px;letter-spacing:.06em;
  text-align:left;
  transition:background .14s ease,border-color .14s ease,color .14s ease;
}
.theme-item:hover{background:var(--btn-bg-hover);color:var(--ink)}
.theme-item:focus-visible{outline:1px solid var(--accent);outline-offset:1px}
.theme-item[aria-pressed="true"]{border-color:var(--frame-line-strong);background:var(--btn-bg-hover);color:var(--ink)}
.theme-dots{flex:none;display:flex}
.theme-dots i{width:13px;height:13px;border-radius:50%;box-shadow:0 0 0 1px rgba(0,0,0,.16)}
.theme-dots i + i{margin-left:-4px}
.theme-name{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-check{flex:none;width:12px;height:12px;stroke:var(--accent);fill:none;stroke-width:1.5;stroke-linecap:round;opacity:0}
.theme-item[aria-pressed="true"] .theme-check{opacity:1}

/* 场景剪影随主题 */
.scene .hills path{fill:var(--scene-hill)}
.scene .branches path{stroke:var(--scene-branch)}
.scene .leaves ellipse{fill:var(--scene-branch)}
/* 四季小院：枝叶随季节 */
html[data-season="spring"] .scene .leaves ellipse{fill:#EFA6C3}
html[data-season="autumn"] .scene .leaves ellipse{fill:#D7985F}
html[data-season="winter"] .scene .leaves ellipse{fill:#DCE6EF;opacity:.45}
html[data-season="winter"] .scene .hills path{filter:brightness(1.12) saturate(.8)}
html[data-season="winter"] .ambient .scene{filter:blur(1.5px) saturate(.82) brightness(1.04)}
.scene .blossoms circle{fill:#F1ADC8;opacity:0;transition:opacity .5s ease}
html[data-season="spring"] .scene .blossoms circle{opacity:.85}
.scene .snowcaps path{fill:#FFFFFF;opacity:0;transition:opacity .5s ease}
html[data-season="winter"] .scene .snowcaps path{opacity:.5}
html{height:100%}
body{
  margin:0;
  min-height:100dvh;
  background:var(--page-solid);
  color:var(--ink);
  font-family:"Noto Sans SC","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
  font-size:16px;
  line-height:1.5;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:18px 16px calc(18px + 66px + env(safe-area-inset-bottom));
  overflow-x:hidden;
  position:relative;
  -webkit-tap-highlight-color:transparent;
  -webkit-font-smoothing:antialiased;
}
body::before{
  content:"";
  position:fixed;inset:0;z-index:-2;
  background:
    radial-gradient(58% 38% at 50% -4%, var(--glow-top), rgba(0,0,0,0) 72%),
    radial-gradient(120% 90% at 50% 108%, var(--page-1) 0%, var(--page-2) 55%, var(--page-3) 100%);
}
body::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none}
.defs{position:absolute;width:0;height:0;overflow:hidden}

/* ============ 环境光 ============ */
.ambient{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.ambient .scene{position:absolute;inset:0;width:100%;height:100%;opacity:.55;filter:blur(1.5px)}
.ambient .glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5}
.ambient .g2{width:420px;height:420px;left:-180px;bottom:-160px;
  background:radial-gradient(circle, var(--ambient-soft), rgba(0,0,0,0) 70%)}
.ambient .firefly{
  position:absolute;width:4px;height:4px;border-radius:50%;
  background:var(--firefly);box-shadow:0 0 10px 3px var(--firefly-glow);
  opacity:.5;animation:drift 12s ease-in-out infinite;
}
.ambient .f1{left:16%;top:26%}
.ambient .f2{right:18%;top:38%;animation-delay:-4s;animation-duration:15s}
.ambient .f3{left:26%;bottom:16%;animation-delay:-8s;animation-duration:18s;opacity:.35}
@keyframes drift{
  0%,100%{transform:translate(0,0);opacity:.35}
  50%{transform:translate(14px,-22px);opacity:.65}
}

/* ============ 布局 ============ */
.game{
  width:min(100%,900px);
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:14px;
}
.intro{display:flex;flex-direction:column;gap:0;min-width:0}
.play{display:flex;flex-direction:column;gap:14px;width:100%;min-width:0}

/* 标题 */
.head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:0 4px}
.brand h1{
  margin:0;
  font-family:"ZCOOL KuaiLe","Noto Sans SC",sans-serif;
  font-weight:400;
  font-size:clamp(28px,6.8vw,33px);
  letter-spacing:.1em;
  line-height:1.15;
  color:var(--title);
  text-shadow:var(--title-shadow);
}
.tagline{margin:6px 0 0;font-size:13px;letter-spacing:.02em;color:var(--ink-soft)}
.level-chip{
  flex:none;white-space:nowrap;
  display:inline-flex;align-items:baseline;gap:3px;
  padding:6px 12px 7px;
  border-radius:999px;
  border:1px solid var(--frame-line-strong);
  background:var(--chip-bg);
  color:var(--chip-fg);font-size:12px;letter-spacing:.08em;
}
.level-chip b{
  font-family:"ZCOOL KuaiLe",sans-serif;font-weight:400;
  font-size:18px;line-height:1;color:var(--title);letter-spacing:.04em;
}
.rules{display:none;list-style:none;margin:0;padding:0}
.rules li{display:flex;gap:11px;align-items:flex-start}
.rules svg{flex:none;width:18px;height:18px;margin-top:2px;stroke:var(--accent);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.rules span{font-size:13px;line-height:1.75;color:var(--ink-soft)}
.lede{display:none}
.best{display:none;align-items:baseline;gap:6px;padding-top:18px;border-top:1px solid var(--hairline);
  font-size:11.5px;letter-spacing:.12em;color:var(--muted)}
.best b{font-size:16px;font-weight:600;letter-spacing:.02em;color:var(--accent);font-variant-numeric:tabular-nums}

/* 数据 */
.stats{display:flex;flex-direction:column;gap:10px;padding:2px 4px 0}
.nums{display:flex;align-items:flex-end;justify-content:space-between}
.stat{display:flex;flex-direction:column;gap:1px}
.stat span{font-size:11.5px;letter-spacing:.14em;color:var(--muted)}
.stat strong{
  font-size:27px;line-height:1.1;font-weight:600;letter-spacing:.02em;
  font-variant-numeric:tabular-nums;
  color:var(--ink);
  transition:color .2s ease;
}
.stat strong.bump{animation:bump .3s ease}
@keyframes bump{0%{transform:scale(1)}40%{transform:scale(1.12)}100%{transform:scale(1)}}
.stat.right{align-items:flex-end}
.stat.right strong{color:var(--accent)}
.stat.right strong.low{color:var(--danger)}
.goal{margin-top:8px}
.track{
  position:relative;height:6px;border-radius:99px;overflow:hidden;
  background:var(--track-bg);
  box-shadow:inset 0 1px 2px rgba(0,0,0,.6);
}
.track i{
  display:block;height:100%;width:0%;border-radius:99px;
  background:linear-gradient(90deg,var(--bar-a),var(--bar-b));
  transition:width .4s cubic-bezier(.3,.8,.4,1);
}
.goal-line{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px;font-size:11.5px;color:var(--muted);letter-spacing:.04em}
.goal-line b{font-weight:500;color:var(--ink-soft)}
.goal-line b.four{font-size:10.5px;letter-spacing:0;white-space:pre-line;line-height:1.4}
.goal-name{font-style:normal;letter-spacing:.1em;color:var(--muted);margin-right:1px}
.star-row[hidden]{display:none}
.star-row{display:inline-flex;align-items:center;gap:2px;flex:none}
.sstar{width:14px;height:14px;fill:none;stroke:var(--muted);stroke-width:1.7;opacity:.5;transition:opacity .2s ease,fill .2s ease,stroke .2s ease}
.sstar.on{fill:var(--accent);stroke:var(--accent);opacity:1}

/* ============ 棋盘 ============ */
.stage{position:relative;width:min(100%,440px,calc(100dvh - 360px));margin:0 auto}
.tray{
  position:relative;
  padding:6px;
  border-radius:26px;
  background:var(--tray-1);
  border:1px solid var(--frame-line);
  box-shadow:0 20px 38px -28px rgba(0,0,0,.6);
}
.board{
  position:relative;
  width:100%;
  aspect-ratio:1/1;
  border-radius:14px;
  overflow:hidden;
  background-color:var(--board-face);
  background-image:
    radial-gradient(78% 56% at 50% -10%, var(--board-glow), rgba(0,0,0,0) 62%),
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size:100% 100%, 12.5% 12.5%, 12.5% 12.5%;
  box-shadow:none;
  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
}
.board.no-anim .tile{transition:none}
.board.shake{animation:shake .32s ease}
@keyframes shake{
  10%,90%{transform:translateX(-3px)}
  30%,70%{transform:translateX(4px)}
  50%{transform:translateX(-2px)}
}
.board.shuffling .tile .art{transform:scale(.55) rotate(16deg);opacity:.3}

.tile{
  position:absolute;left:0;top:0;
  width:12.5%;height:12.5%;
  transform:translate(calc(var(--c,0) * 100%), calc(var(--r,0) * 100%));
  transition:transform .24s cubic-bezier(.3,.85,.4,1);
  will-change:transform;
  z-index:1;
}
.tile .art{
  position:absolute;inset:5.5%;
  display:grid;place-items:center;
  transition:transform .18s ease, opacity .18s ease, filter .3s ease;
  filter:drop-shadow(0 2px 4px rgba(0,0,0,.22));
  z-index:2;
}
.tile .art svg{width:100%;height:100%;display:block}
.tile.pop{z-index:0}
.tile.pop .art{
  transform:scale(.18) rotate(-12deg);opacity:0;
  transition:transform .19s cubic-bezier(.4,0,.7,.3), opacity .19s linear;
}
.tile.sel{z-index:5}
.tile.sel .art{transform:scale(1.06)}
.tile.sel::after{
  content:"";position:absolute;inset:1%;
  border-radius:42%;
  box-shadow:0 0 0 1px var(--accent), 0 0 16px var(--hint-glow);
}
.tile.hint{z-index:4}
.tile.hint .art{animation:hintPulse 1.05s ease-in-out infinite;filter:drop-shadow(0 0 12px rgba(246,205,132,.8))}
.tile.hint::after{
  content:"";position:absolute;inset:0;border-radius:46%;
  box-shadow:0 0 0 1.5px rgba(246,214,150,.85), 0 0 20px rgba(246,205,132,.3);
  animation:hintRing 1.05s ease-in-out infinite;
}
@keyframes hintRing{0%,100%{opacity:.9}50%{opacity:.3}}
@keyframes hintPulse{
  0%,100%{transform:scale(1)}
  45%{transform:scale(1.13)}
}
.tile.special-bomb::before,.tile.special-rainbow::before{
  content:"";position:absolute;inset:0;border-radius:50%;
  background:radial-gradient(circle, var(--court-glow), rgba(255,255,255,0) 68%);
  animation:halo 2.4s ease-in-out infinite;
  z-index:0;
}
.tile.special-rainbow::before{background:radial-gradient(circle, rgba(255,232,178,.26), rgba(255,232,178,0) 68%)}
@keyframes halo{0%,100%{opacity:.55;transform:scale(.94)}50%{opacity:1;transform:scale(1.02)}}
.tile.birth .art{animation:birth .5s cubic-bezier(.2,1.5,.4,1)}
@keyframes birth{0%{transform:scale(.35);opacity:.3}100%{transform:scale(1);opacity:1}}

/* 特效层 */
.fx{position:absolute;inset:0;pointer-events:none;z-index:6;overflow:visible}
.pt{
  position:absolute;width:7px;height:7px;border-radius:50%;
  transform:translate(-50%,-50%);
  animation:ptFly .68s cubic-bezier(.2,.7,.3,1) forwards;
}
@keyframes ptFly{
  0%{opacity:1;transform:translate(-50%,-50%) scale(1)}
  100%{opacity:0;transform:translate(-50%,-50%) translate(var(--dx),var(--dy)) scale(.25)}
}
.float{
  position:absolute;white-space:nowrap;color:var(--ink);
  transform:translate(-50%,-50%);
  font-size:15px;font-weight:700;letter-spacing:.02em;
  color:var(--ink);
  animation:floatUp .88s ease-out forwards;
}
@keyframes floatUp{
  0%{opacity:0;transform:translate(-50%,-50%) translateY(8px) scale(.8)}
  22%{opacity:1;transform:translate(-50%,-50%) translateY(-8px) scale(1)}
  100%{opacity:0;transform:translate(-50%,-50%) translateY(-46px) scale(1)}
}

/* 连击 */
.combo{
  position:absolute;left:50%;top:20%;
  transform:translate(-50%,0);
  pointer-events:none;
  font-family:"ZCOOL KuaiLe",sans-serif;
  font-size:26px;letter-spacing:.06em;
  color:var(--danger);
  text-shadow:0 3px 0 rgba(255,255,255,.72);
  opacity:0;white-space:nowrap;
}
.combo.show{animation:comboPop 1s ease forwards}
@keyframes comboPop{
  0%{opacity:0;transform:translate(-50%,14px) scale(.82)}
  22%{opacity:1;transform:translate(-50%,0) scale(1)}
  72%{opacity:1;transform:translate(-50%,-6px) scale(1)}
  100%{opacity:0;transform:translate(-50%,-22px) scale(.98)}
}

/* ============ 底栏 ============ */
.foot{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:0 4px}
.foot button{
  appearance:none;cursor:pointer;
  display:inline-flex;align-items:center;gap:6px;white-space:nowrap;
  min-height:44px;
  padding:10px 8px;border-radius:999px;
  border:1px solid var(--btn-line);
  background:var(--btn-bg);
  color:var(--btn-fg);
  font-family:inherit;font-size:12.5px;letter-spacing:.1em;
  transition:background .16s ease,border-color .16s ease,color .16s ease,transform .1s ease;
}
.foot button svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
.foot button:hover{background:var(--btn-bg-hover);border-color:var(--frame-line-strong);color:var(--btn-fg-hover)}
.foot button:active{transform:translateY(1px)}
.foot button[aria-pressed="false"]{color:var(--muted);border-color:var(--hairline)}
.foot button:focus-visible{outline:1px solid var(--accent);outline-offset:3px}

/* ============ 提示条 ============ */
.toast{
  position:fixed;left:50%;bottom:calc(80px + env(safe-area-inset-bottom));z-index:40;
  transform:translate(-50%,16px);
  padding:9px 18px;border-radius:999px;
  background:var(--toast-bg);
  border:1px solid var(--toast-line);
  color:var(--toast-fg);font-size:13px;letter-spacing:.04em;
  opacity:0;pointer-events:none;
  transition:opacity .26s ease, transform .26s ease;
}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* ============ 结算 ============ */
.overlay{
  position:fixed;inset:0;z-index:60;
  display:grid;place-items:center;
  padding:24px;
  background:var(--dim);
  animation:fadeIn .22s ease;
}
.overlay[hidden]{display:none}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.sheet{
  width:min(100%,352px);
  padding:28px 24px 22px;
  border-radius:20px;
  text-align:center;
  background:
    radial-gradient(120% 80% at 50% 0%, var(--sheet-glow), rgba(0,0,0,0) 60%),
    linear-gradient(180deg,var(--sheet-a) 0%, var(--sheet-b) 100%);
  border:1px solid var(--sheet-line);
  box-shadow:0 34px 70px -24px rgba(0,0,0,.9), 0 1px 0 rgba(255,255,255,.06) inset;
  animation:sheetIn .32s cubic-bezier(.2,.9,.3,1);
}
@keyframes sheetIn{from{opacity:0;transform:translateY(16px) scale(.96)}to{opacity:1;transform:none}}
.sheet .kicker{margin:0;font-size:11.5px;letter-spacing:.22em;color:var(--sheet-kicker)}
.sheet h2{
  margin:10px 0 6px;
  font-family:"ZCOOL KuaiLe",sans-serif;font-weight:400;
  font-size:26px;letter-spacing:.06em;color:var(--ink);
}
.sheet-body{margin:0;font-size:13px;line-height:1.7;color:var(--sheet-body);white-space:pre-line}
.sheet-stats{display:flex;justify-content:center;gap:34px;margin:18px 0 20px;padding:14px 0;
  border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline)}
.sheet-stats div{display:flex;flex-direction:column;gap:3px}
.sheet-stats span{font-size:11px;letter-spacing:.1em;color:var(--muted)}
.sheet-stats b{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--sheet-num)}
.sheet-stars{display:flex;justify-content:center;gap:9px;margin:14px 0 2px}
.sheet-stars[hidden]{display:none}
.sheet-stars svg{width:30px;height:30px;fill:none;stroke:var(--muted);stroke-width:1.7;opacity:.35;transition:none}
.sheet-stars svg.on{fill:var(--accent);stroke:var(--accent);opacity:1;filter:drop-shadow(0 3px 6px rgba(0,0,0,.16))}
.sheet-star-tip{margin:5px 0 0;font-size:11.5px;letter-spacing:.04em;color:var(--muted)}
.sheet-star-tip[hidden]{display:none}
.sheet-tools{display:grid;gap:8px;margin:16px 0 8px}
.sheet-tools[hidden]{display:none}
.sheet-tools .tool{
  appearance:none;cursor:pointer;width:100%;
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:11px 14px;border-radius:15px;
  border:1px solid var(--frame-line);background:var(--face-1);
  color:var(--ink);font-family:inherit;font-size:13px;letter-spacing:.06em;text-align:left;
}
.sheet-tools .tool b{font-weight:500}
.sheet-tools .tool span{font-size:11px;letter-spacing:.08em;color:var(--muted)}
.sheet-tools .tool:disabled{opacity:.42;cursor:not-allowed}
.sheet-tools .tool:not(:disabled):hover{border-color:var(--frame-line-strong)}
.sheet .primary{
  appearance:none;cursor:pointer;width:100%;
  padding:13px 18px;border-radius:999px;border:1px solid var(--primary-line);
  background:linear-gradient(180deg,var(--primary-a),var(--primary-b));
  color:var(--primary-fg);font-family:inherit;font-size:14px;font-weight:600;letter-spacing:.12em;
  box-shadow:0 10px 24px -10px var(--primary-glow);
  transition:filter .16s ease, transform .1s ease;
}
.sheet .primary:hover{filter:brightness(1.06)}
.sheet .primary:active{transform:translateY(1px)}
.sheet .primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ============ 天气 / 灯笼 / 竹篮 ============ */
.weather-fx{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden;opacity:0;transition:opacity .5s ease}
body[data-weather="rain"] .weather-fx.rain,
body[data-weather="fog"] .weather-fx.fog,
body[data-weather="leaf"] .weather-fx.leaf{opacity:1}
.weather-fx.rain{background:repeating-linear-gradient(102deg,rgba(86,128,162,.13) 0 1px,rgba(86,128,162,0) 1px 21px);animation:rainSweep 2.4s linear infinite}
body.page-open .weather-fx{opacity:0}
@keyframes rainSweep{from{background-position:0 -140px}to{background-position:0 140px}}
.weather-fx.fog{background:
  radial-gradient(44% 30% at 24% 34%,rgba(206,216,224,.22),rgba(232,240,238,0) 72%),
  radial-gradient(38% 26% at 74% 62%,rgba(206,216,224,.18),rgba(232,240,238,0) 72%);
  background-size:130% 130%,120% 120%;
  animation:fogDrift 26s ease-in-out infinite alternate}
@keyframes fogDrift{from{background-position:-8% -6%,92% 84%}to{background-position:8% 6%,100% 100%}}
.weather-fx.leaf i{position:absolute;top:-8%;width:13px;height:13px;border-radius:52% 0 52% 0;
  background:linear-gradient(135deg,#E3AB67,#B4783E);opacity:.34;animation:leafFall linear infinite}
.weather-fx.leaf i:nth-child(1){left:9%;animation-duration:14s;animation-delay:-1s}
.weather-fx.leaf i:nth-child(2){left:26%;animation-duration:18s;animation-delay:-7s}
.weather-fx.leaf i:nth-child(3){left:44%;animation-duration:16s;animation-delay:-4s}
.weather-fx.leaf i:nth-child(4){left:62%;animation-duration:20s;animation-delay:-11s}
.weather-fx.leaf i:nth-child(5){left:78%;animation-duration:15s;animation-delay:-3s}
.weather-fx.leaf i:nth-child(6){left:91%;animation-duration:17s;animation-delay:-9s}
@keyframes leafFall{0%{transform:translate3d(0,0,0) rotate(0);opacity:0}
  10%{opacity:.34}
  100%{transform:translate3d(40px,116vh,0) rotate(260deg);opacity:0}}

/* 四季飘落：花瓣 / 花粉 / 落叶 / 雪 */
.season-fx{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.season-fx i{position:absolute;top:-7%;left:var(--left,10%);display:block;opacity:0;
  animation:seasonFall var(--dur,18s) linear infinite;animation-delay:var(--delay,0s)}
.season-fx i:nth-child(1){--left:7%;--dur:17s;--delay:-2s;--drift:30px}
.season-fx i:nth-child(2){--left:18%;--dur:21s;--delay:-9s;--drift:-22px}
.season-fx i:nth-child(3){--left:29%;--dur:15s;--delay:-5s;--drift:38px}
.season-fx i:nth-child(4){--left:40%;--dur:23s;--delay:-13s;--drift:-30px}
.season-fx i:nth-child(5){--left:52%;--dur:19s;--delay:-1s;--drift:26px}
.season-fx i:nth-child(6){--left:63%;--dur:16s;--delay:-8s;--drift:-34px}
.season-fx i:nth-child(7){--left:74%;--dur:22s;--delay:-15s;--drift:22px}
.season-fx i:nth-child(8){--left:84%;--dur:18s;--delay:-6s;--drift:-26px}
.season-fx i:nth-child(9){--left:92%;--dur:20s;--delay:-11s;--drift:34px}
.season-fx i:nth-child(10){--left:48%;--dur:24s;--delay:-17s;--drift:-18px}
html[data-season="spring"] .season-fx i{width:7px;height:6px;background:#E992B1;border-radius:62% 38% 58% 42%;box-shadow:0 0 0 1px rgba(214,110,150,.18)}
html[data-season="summer"] .season-fx i{width:4px;height:4px;background:#E6BF63;border-radius:50%;box-shadow:0 0 6px rgba(226,183,88,.5)}
html[data-season="autumn"] .season-fx i{width:8px;height:8px;background:linear-gradient(135deg,#DFA265,#B9783F);border-radius:52% 0 52% 0}
html[data-season="winter"] .season-fx i{width:6px;height:6px;background:#FFFFFF;border-radius:50%;box-shadow:0 0 0 1px rgba(118,142,172,.34),0 0 7px rgba(255,255,255,.65)}
@keyframes seasonFall{
  0%{transform:translate3d(0,0,0) rotate(0);opacity:0}
  8%{opacity:.55}
  100%{transform:translate3d(var(--drift,24px),112vh,0) rotate(300deg);opacity:0}
}
@media (prefers-reduced-motion: reduce){.season-fx{display:none}}

.modbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 4px;margin-bottom:6px}
.weather-chip{appearance:none;cursor:pointer;display:inline-flex;align-items:center;gap:6px;
  min-height:38px;padding:6px 13px;border-radius:999px;
  border:1px solid var(--frame-line);background:var(--chip-bg);
  color:var(--chip-fg);font-family:inherit;font-size:11.5px;letter-spacing:.1em;
  transition:background .16s ease,border-color .16s ease,color .16s ease}
.weather-chip:hover{background:var(--btn-bg-hover);border-color:var(--frame-line-strong);color:var(--ink)}
.weather-chip:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
.weather-chip .wicon{display:inline-flex;width:15px;height:15px}
.weather-chip .wicon svg{width:100%;height:100%;stroke:var(--accent);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.weather-chip b{font-weight:500;color:var(--ink-soft);letter-spacing:.12em}
.oil-chip{appearance:none;cursor:pointer;display:inline-flex;align-items:center;gap:5px;
  min-height:38px;padding:6px 12px;border-radius:999px;
  border:1px solid var(--frame-line);background:var(--chip-bg);
  color:var(--chip-fg);font-family:inherit;font-size:11.5px;letter-spacing:.1em;
  transition:background .16s ease,border-color .16s ease,color .16s ease}
.oil-chip:hover{background:var(--btn-bg-hover);border-color:var(--frame-line-strong);color:var(--ink)}
.oil-chip:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
.oil-chip b{font-weight:600;color:var(--accent);letter-spacing:.04em;font-variant-numeric:tabular-nums}
.oil-drop{width:9px;height:13px;flex:none;border-radius:50% 50% 55% 55%/60% 60% 45% 45%;
  background:var(--accent);opacity:.85;display:inline-block}
.lanterns{display:flex;align-items:center;gap:7px}
.lanterns > span{font-size:10.5px;letter-spacing:.16em;color:var(--muted)}
.lantern{width:19px;height:24px;flex:none;display:block;opacity:.72;transition:opacity .3s ease,filter .3s ease}
.lantern svg{width:100%;height:100%;overflow:visible}
.lantern .lg-string,.lantern .lg-line,.lantern .lg-tail{stroke:var(--frame-line-strong);stroke-width:1;fill:none}
.lantern .lg-cap{fill:var(--muted);opacity:.85}
.lantern .lg-body{fill:rgba(255,255,255,.85);stroke:var(--frame-line-strong);stroke-width:1}
.lantern.on{opacity:1;filter:drop-shadow(0 0 7px rgba(246,205,132,.55))}
.lantern.on .lg-body{fill:url(#gLamp);stroke:#FFE7B2}
.lantern.on .lg-line{stroke:rgba(120,70,30,.32)}
.lantern.on .lg-cap{fill:#8A5A2A;opacity:1}
.lantern.pop svg{animation:lampPop .5s cubic-bezier(.2,1.4,.4,1)}
@keyframes lampPop{0%{transform:scale(.72)}55%{transform:scale(1.15)}100%{transform:scale(1)}}

.cover-layer{position:absolute;inset:0;z-index:3;border-radius:14px;overflow:hidden;pointer-events:none}
.cover{position:absolute;left:0;top:0;width:12.5%;height:12.5%;
  transform:translate(calc(var(--c,0) * 100%),calc(var(--r,0) * 100%));
  transition:opacity .28s ease}
.cover.breaking{opacity:0;transform:translate(calc(var(--c,0) * 100%),calc(var(--r,0) * 100%)) scale(1.3)}
.cover svg{width:100%;height:100%;display:block}
.cover.fog{border-radius:44%;
  background:radial-gradient(ellipse at 50% 46%,var(--fog-tint),rgba(198,210,220,.55) 58%,rgba(198,210,220,0) 78%)}
.cover.fog::after{content:"";position:absolute;inset:22% 16% 26%;border-radius:50%;
  background:radial-gradient(ellipse,rgba(255,255,255,.6),rgba(255,255,255,0) 72%)}
.cover.rain{background:radial-gradient(circle at 50% 58%,rgba(126,182,212,.3),rgba(126,182,212,0) 74%)}
.cover.leaf{background:radial-gradient(circle at 50% 56%,rgba(196,136,74,.18),rgba(196,136,74,0) 72%)}
.block-layer{position:absolute;inset:0;z-index:4;overflow:hidden;pointer-events:none}
.block{position:absolute;left:0;top:0;width:12.5%;height:12.5%;
  transform:translate(calc(var(--c,0) * 100%),calc(var(--r,0) * 100%));
  transition:opacity .3s ease,transform .3s ease}
.block.breaking{opacity:0;transform:translate(calc(var(--c,0) * 100%),calc(var(--r,0) * 100%)) scale(1.28) rotate(8deg)}
.block svg{width:100%;height:100%;display:block;opacity:.94}
.block-lock{position:absolute;right:5%;bottom:5%;width:30%;height:30%;display:block;opacity:.96;
  filter:drop-shadow(0 1px 1px rgba(84,58,66,.22))}
.block-lock rect{fill:var(--accent);stroke:none}
.block-lock path{fill:none;stroke:var(--accent);stroke-width:1.4;stroke-linecap:round}
.block-lock circle{fill:var(--face-1)}
.block.vine{background:radial-gradient(circle at 50% 54%,rgba(88,150,96,.26),rgba(88,150,96,0) 74%)}
.block.ice{background:radial-gradient(circle at 50% 50%,rgba(122,184,216,.3),rgba(150,205,232,0) 76%)}
.block.chain{background:radial-gradient(circle at 50% 50%,rgba(96,104,114,.2),rgba(96,104,114,0) 74%)}
.block.pile{background:radial-gradient(circle at 50% 56%,rgba(196,136,74,.22),rgba(196,136,74,0) 74%)}

.court{position:absolute;inset:0;border-radius:16px;z-index:7;pointer-events:none;opacity:0;
  background:radial-gradient(circle at 50% 48%,var(--court-glow),rgba(255,255,255,0) 66%)}
.court.on{animation:courtFlash 1s ease}
@keyframes courtFlash{0%{opacity:0;transform:scale(.88)}22%{opacity:.95}100%{opacity:0;transform:scale(1.06)}}

.goal-icon{display:inline-flex;width:15px;height:15px;vertical-align:-3px;margin:0 4px}
.goal-icon svg{width:100%;height:100%;display:block}
.goal-icon .gl-ic path,.goal-icon .gl-ic circle{fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.star-row{cursor:pointer}


/* ============ 底栏 tab 菜单 ============ */
.tabbar{
  position:fixed;left:50%;bottom:0;transform:translateX(-50%);
  width:min(100%,560px);z-index:56;
  background:var(--face-1);
  border-top:1px solid var(--frame-line);
  border-radius:16px 16px 0 0;
  box-shadow:0 -10px 26px rgba(122,52,84,.14);
  padding:6px 10px calc(6px + env(safe-area-inset-bottom));
}
.tabbar-in{display:grid;grid-template-columns:repeat(5,1fr);gap:3px}
body.sheet-open .tabbar{opacity:0;pointer-events:none;transform:translate(-50%,12px)}
.tabbar{transition:opacity .2s ease,transform .2s ease}
@media (min-width:760px){
  .tabbar{bottom:10px;border-radius:18px;border:1px solid var(--frame-line);
    box-shadow:0 16px 34px -24px var(--shadow-ink)}
}
.tab{
  position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  padding:6px 4px 5px;border:0;background:transparent;font-family:inherit;font-size:11.5px;font-weight:500;
  color:var(--muted);border-radius:12px;cursor:pointer;touch-action:manipulation;
  transition:background .16s ease,color .16s ease;
}
.tab svg{width:21px;height:21px;display:block;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.tab[aria-selected="true"]{color:var(--ink);background:color-mix(in srgb, var(--accent) 12%, transparent)}
