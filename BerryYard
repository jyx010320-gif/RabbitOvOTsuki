      + '<span class="mode-copy"><b>' + MODE_NAMES[key] + '</b><span>'
      + (key === 'story' ? '接着上次的进度继续收果'
        : key === 'daily' ? '同一盘，一天三次'
        : key === 'score' ? '短局冲分，步数用完就结算'
        : key === 'zen' ? '没有目标，消到心静'
        : '和障碍赛跑，把院子清出来')
      + '</span><span class="mode-meta">' + meta + '</span></span>'
      + '<span class="mode-pill">' + pill + '</span></button>';
    html += card('story', '第' + info.chapter + '章 · ' + info.inChapter + '/' + CHAPTER_LEN + ' 关', state.mode === 'story' && !state.over ? '继续' : '去闯关');
    html += card('daily', rec.done ? '今天已完成' : '剩 ' + rec.left + ' 次 · 最好 ' + rec.best + ' 分', state.mode === 'daily' ? '接着玩' : '开一局');
    html += card('score', SCORE_MOVES + ' 步 · 最好 ' + scoreBest + ' 分', state.mode === 'score' ? '接着玩' : '开始');
    html += card('zen', '不限步数 · 没有失败', state.mode === 'zen' ? '接着玩' : '开始');
    html += card('challenge', CHALLENGE_MOVES + ' 步清 6 处 · 最好 ' + clearBest + ' 分', state.mode === 'challenge' ? '接着玩' : '开始');
    modeListEl.innerHTML = html;
  }

  /* ---------- 每日一关 ---------- */
  function startDaily() {
    ensureAudio();
    if (state.busy) return;
    if (state.paused && !state.over) return;
    if (state.mode === 'daily') {
      toast('正在每日一关里，先把这盘走完');
      return;
    }
    const rec = loadDaily();
    if (rec.done) { showDailyDoneSheet(rec); return; }
    if (rec.left <= 0) { showDailyEmptySheet(rec); return; }
    rememberStory();
    rec.left = Math.max(0, rec.left - 1);
    saveDaily(rec);
    startDailyRun(rec);
  }

  function exitDaily() {
    if (state.mode !== 'daily') { state.paused = false; return; }
    state.mode = 'story';
    state.score = state.storyScore || 0;
    startLevel(state.storyLevel || state.level, true);
    toast('回到小院');
  }

  function showDailyDoneSheet(rec) {
    openSheet({
      kind: 'level',
      kicker: '每日一关 · 今日',
      title: rec.stars >= 3 ? '今天的三星' : '今天已经收满了',
      body: '今日最好 ' + rec.best.toLocaleString('zh-CN') + ' 分 · ' + rec.stars + ' 星。明早换一盘新的。',
      score: rec.best,
      best: rec.best,
      btn: state.mode === 'daily' ? '回小院' : '知道了',
      action: () => { if (state.mode === 'daily') exitDaily(); }
    });
  }

  function showDailyEmptySheet(rec) {
    openSheet({
      kind: 'over',
      kicker: '每日一关 · 今日',
      title: '今天的 3 次用完了',
      body: '今日最好 ' + rec.best.toLocaleString('zh-CN') + ' 分。明早 0 点换新盘，同一盘每天只发一次。',
      score: rec.best,
      best: rec.best,
      btn: state.mode === 'daily' ? '回小院' : '知道了',
      action: () => { if (state.mode === 'daily') exitDaily(); }
    });
  }

  /* ---------- 灯油小铺 ---------- */
  const TOOL_COST = { steps: 1, goal: 2, shuffle: 1 };

  function initOil() {
    state.oil = loadOil();
    if (oilValEl) oilValEl.textContent = state.oil;
  }

  function refreshTools() {
    if (!sheetToolsEl) return;
    sheetKicker.textContent = '灯油 ' + state.oil;
    const goalBlocked = goalDone() || state.mode === 'score' || state.mode === 'weekly' || state.mode === 'zen';
    sheetToolsEl.querySelectorAll('.tool').forEach((b) => {
      const tool = b.dataset.tool;
      const cost = TOOL_COST[tool] || 1;
      const unavailable = (tool === 'goal' && goalBlocked) || (tool === 'steps' && state.mode === 'zen');
      b.disabled = state.oil < cost || unavailable;
      const tag = b.querySelector('span');
      if (tag) tag.textContent = tool === 'steps' && state.mode === 'zen' ? '不限步数'
        : tool === 'goal' && goalBlocked ? '本模式不可用'
        : cost + ' 灯油';
    });
  }

  function openToolsSheet() {
    ensureAudio();
    if (state.busy) { toast('等这一手消完'); return; }
    if (state.paused && !overlay.hidden) return;
    closeThemePop();
    overlay.hidden = false;
    state.paused = true;
    document.body.classList.add('sheet-open');
    sheetStarsEl.hidden = true;
    sheetStarTipEl.hidden = true;
    sheetStatsEl.style.display = 'none';
    sheetToolsEl.hidden = false;
    sheetTitle.textContent = '灯油小铺';
    sheetBody.textContent = '过关和每日完成都能攒灯油。挑一样小帮忙，不花步数。';
    sheetBtn.textContent = '回去继续';
    sheetBtn.onclick = () => { overlay.hidden = true; state.paused = false; document.body.classList.remove('sheet-open'); };
    refreshTools();
    overlay.querySelector('.sheet').setAttribute('tabindex', '-1');
  }

  async function useTool(tool) {
    const cost = TOOL_COST[tool] || 1;
    if (state.oil < cost) { toast('灯油不够，先过关攒一点'); return; }
    if (tool === 'goal' && (goalDone() || state.mode === 'score' || state.mode === 'weekly' || state.mode === 'zen')) {
      toast('这个模式没有可补的目标');
      return;
    }
    if (tool === 'steps' && state.mode === 'zen') { toast('禅意小院不限步数'); return; }
    saveOil(state.oil - cost);
    if (tool === 'steps') {
      state.moves += 3;
      updateHud();
      toast('补了 3 步');
    } else if (tool === 'goal') {
      state.goal.got = Math.min(state.goal.need, state.goal.got + 1);
      updateGoalUi();
      updateHud();
      toast('目标进了一格');
      if (goalDone()) {
        overlay.hidden = true;
        state.paused = false;
        document.body.classList.remove('sheet-open');
        showLevelSheet();
        return;
      }
    } else {
      overlay.hidden = true;
      state.paused = false;
      document.body.classList.remove('sheet-open');
      await shuffleBoard(false);
      toast('重新洗了一手');
      return;
    }
    refreshTools();
  }

  /* ============================================================
     音效（Web Audio，纯代码合成）
     ============================================================ */
  let audioCtx = null;

  function ensureAudio() {
    if (state.muted) return;
    try {
      if (!audioCtx) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        audioCtx = new AC();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
    } catch (err) { audioCtx = null; }
  }

  function tone(freq, dur, vol, type) {
    if (state.muted || !audioCtx) return;
    try {
      const t0 = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type || 'triangle';
      osc.frequency.setValueAtTime(freq, t0);
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.linearRampToValueAtTime(vol, t0 + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + dur + 0.03);
    } catch (err) { /* 忽略 */ }
  }

  function playSwap() { tone(320, 0.07, 0.04, 'sine'); }
  function playInvalid() { tone(150, 0.13, 0.045, 'sawtooth'); }
  function playPop(chain) {
    const f = 470 + Math.min(chain, 6) * 60;
    tone(f, 0.1, 0.05, 'triangle');
    if (chain >= 3) tone(f * 1.5, 0.14, 0.028, 'sine');
  }
  function playShuffle() {
    tone(260, 0.14, 0.035, 'sine');
    setTimeout(() => tone(310, 0.14, 0.03, 'sine'), 90);
  }
  function playLantern(n) {
    tone(500 + n * 70, 0.4, 0.045, 'sine');
    setTimeout(() => tone(720 + n * 50, 0.3, 0.03, 'sine'), 130);
  }

  function playCourt() {
    [523, 659, 784, 1047, 1319].forEach((f, i) => setTimeout(() => tone(f, 0.42, 0.05, 'sine'), i * 90));
  }

  function playChime(kind) {
    const notes = kind === 'level' ? [523, 659, 784, 1047] : [392, 330, 262];
    notes.forEach((f, i) => setTimeout(() => tone(f, 0.34, 0.045, 'sine'), i * 120));
  }

  /* ============================================================
     配色切换
     ============================================================ */
  const CUSTOM_KEY = 'xiaoyuan-match3-custom';
  let customHex = '#C74D80';

  function hexToHsl(hex) {
    const r = parseInt(hex.slice(1, 3), 16) / 255,
          g = parseInt(hex.slice(3, 5), 16) / 255,
          b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0;
    const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
      else if (max === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60;
    }
    return { h: Math.round(h), s: Math.round(s * 100), l: Math.round(l * 100) };
  }

  /* 由一枚主色推出整套小院配色：浅纸底 + 主色阶 + 墨色文字 + 浅棋盘 */
  function buildPaletteVars(hex) {
    const c = hexToHsl(hex);
    const H = c.h;
    const S = c.s < 10 ? 10 : Math.min(86, Math.max(34, c.s));
    const L = Math.min(56, Math.max(42, c.l));
    const p = (l, k = 1) => 'hsl(' + H + ' ' + Math.round(S * k) + '% ' + l + '%)';
    const a = (l, al, k = 1) => 'hsla(' + H + ', ' + Math.round(S * k) + '%, ' + l + '%, ' + al + ')';
    const p100 = p(93, .8), p500 = p(L), p600 = p(Math.max(27, L - 15));
    return {
      '--page-solid': p(96, .7),
      '--page-1': p(94, .7), '--page-2': p(92, .7), '--page-3': p(90, .7),
      '--glow-top': 'rgba(255,255,255,.55)',
      '--ink': p(20, .45), '--ink-soft': p(46, .34), '--muted': p(58, .24),
      '--title': p(15, .4), '--title-shadow': '0 2px 18px ' + a(35, .18, .6),
      '--accent': p500, '--danger': '#C74B3E',
      '--chip-fg': p(46, .34), '--chip-bg': 'rgba(255,255,255,.72)',
      '--frame-line': a(58, .24, .9), '--frame-line-strong': a(52, .44, .9),
      '--btn-line': a(20, .14, .5), '--hairline': a(20, .14, .5),
      '--tray-1': p100, '--tray-2': p(91, .8), '--tray-3': p(88, .85),
      '--board-face': p(92, .85), '--grid': a(56, .16, .9), '--board-glow': 'rgba(255,255,255,.4)',
      '--btn-bg': '#FFFFFF', '--btn-bg-hover': p(97, .55),
      '--btn-fg': p(20, .45), '--btn-fg-hover': p(15, .4),
      '--track-bg': 'rgba(255,255,255,.88)',
      '--bar-a': p(78, .85), '--bar-b': p100,
      '--toast-bg': '#FFFFFF', '--toast-fg': p(20, .45), '--toast-line': a(52, .34, .9),
      '--dim': a(28, .42, .5),
      '--sheet-a': '#FFFFFF', '--sheet-b': '#FFFFFF', '--sheet-glow': 'rgba(255,255,255,.5)', '--sheet-line': a(52, .3, .9),
      '--sheet-kicker': p600, '--sheet-body': p(46, .34), '--sheet-num': p(15, .4),
      '--primary-a': p(Math.max(30, L - 6)), '--primary-b': p(Math.max(26, L - 13)), '--primary-fg': '#FFFFFF',
      '--primary-line': a(52, .45), '--primary-glow': a(55, .32),
      '--scene-hill': p(92, .7), '--scene-branch': p(80, .7),
      '--ambient-soft': 'rgba(255,255,255,.5)',
      '--firefly': p(76, .9), '--firefly-glow': a(62, .4),
      '--cut': p600,
      '--face-1': '#FFFFFF', '--face-1hi': p100, '--face-panel': p(97, .55), '--face-sheet': '#FFFFFF',
      '--shadow-ink': a(32, .18, .6),
      '--hill-a': p100, '--hill-b': p(90, .8),
      '--board-edge': '#FFFFFF', '--board-ring': a(38, .16, .7),
      '--checker': 'rgba(0,0,0,.035)',
      '--piece-cut': p(20, .45),
      '--art-shadow': a(34, .16, .5),
      '--hint-glow': a(55, .45, .9), '--court-glow': a(75, .45, .9),
      '--rain-line': 'rgba(80,126,164,.16)', '--fog-tint': 'rgba(224,232,238,.92)',
      '--piece-crease': 'rgba(110,60,60,.55)', '--piece-vein': 'rgba(50,95,70,.55)', '--piece-glint': 'rgba(255,255,255,.9)'
    };
  }

  function clearCustomVars() {
    const st = document.documentElement.style;
    for (let i = st.length - 1; i >= 0; i--) {
      const name = st[i];
      if (name && name.indexOf('--') === 0) st.removeProperty(name);
    }
  }

  function applyCustomPalette(hex, announce) {
    if (!/^#[0-9a-fA-F]{6}$/.test(hex)) hex = '#C74D80';
    const vars = buildPaletteVars(hex);
    clearCustomVars();
    Object.keys(vars).forEach((k) => document.documentElement.style.setProperty(k, vars[k]));
    document.documentElement.setAttribute('data-theme', 'custom');
    customHex = hex;
    try {
      localStorage.setItem(CUSTOM_KEY, hex);
      localStorage.setItem(THEME_STORE, 'custom');
    } catch (err) { /* 忽略 */ }
    if (customColorEl) customColorEl.value = hex;
    if (customRow) customRow.classList.add('on');
    if (customNow) customNow.hidden = false;
    markPressed('');
    if (announce) toast('按这枚主色调好一套');
  }

  function markPressed(key) {
    if (!themeList) return;
    themeList.querySelectorAll('.theme-item').forEach((el) => {
      el.setAttribute('aria-pressed', String(el.dataset.key === key));
    });
  }

  function currentTheme() {
    const key = document.documentElement.getAttribute('data-theme');
    if (key === 'custom') return { key: 'custom', name: '自定义' };
    return THEMES.find((t) => t.key === key) || THEMES[0];
  }

  function applyTheme(key, announce) {
    if (key === 'custom') { applyCustomPalette(customHex, announce); return; }
    clearCustomVars();
    if (customRow) customRow.classList.remove('on');
    if (customNow) customNow.hidden = true;
    const theme = THEMES.find((t) => t.key === key) || THEMES[0];
    document.documentElement.setAttribute('data-theme', theme.key);
    try { localStorage.setItem(THEME_STORE, theme.key); } catch (err) { /* 忽略 */ }
    markPressed(theme.key);
    if (announce) toast('换成「' + theme.name + '」');
  }

  function buildThemeList() {
    if (!themeList) return;
    themeList.innerHTML = '';
    for (const t of THEMES) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'theme-item';
      b.dataset.key = t.key;
      b.setAttribute('aria-pressed', String(t.key === currentTheme().key));
      b.innerHTML = '<span class="theme-dots">' +
        t.dots.map((c) => '<i style="background:' + c + '"></i>').join('') +
        '</span><span class="theme-name">' + t.name + '</span>' +
        '<svg class="theme-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.6l4.4 4.4L19 7.4"/></svg>';
      b.addEventListener('click', () => { applyTheme(t.key, true); closeThemePop(); });
      themeList.appendChild(b);
    }
  }

  function openThemePop() {
    themePop.hidden = false;
  }

  function closeThemePop() {
    themePop.hidden = true;
    document.body.classList.remove('theme-open');
  }

  function initTheme() {
    let saved = '', savedHex = '';
    try {
      saved = localStorage.getItem(THEME_STORE) || '';
      savedHex = localStorage.getItem(CUSTOM_KEY) || '';
    } catch (err) { /* 忽略 */ }
    if (/^#[0-9a-fA-F]{6}$/.test(savedHex)) customHex = savedHex;
    const keys = THEMES.map((t) => t.key);
    if (saved === 'custom') applyTheme('custom', false);
    else applyTheme(keys.indexOf(saved) >= 0 ? saved : THEMES[0].key, false);
    buildThemeList();
    if (customColorEl) customColorEl.value = customHex;
    if (customApplyBtn) {
      customApplyBtn.addEventListener('click', () => {
        applyTheme('custom', true);
        closeThemePop();
      });
    }
    if (customColorEl) {
      const takeHex = () => {
        if (/^#[0-9a-fA-F]{6}$/.test(customColorEl.value)) customHex = customColorEl.value;
      };
      customColorEl.addEventListener('input', takeHex);
      customColorEl.addEventListener('change', takeHex);
    }
  }

  /* ============================================================
     杂项
     ============================================================ */
  let toastTimer = null;
  function toast(text) {
    toastEl.textContent = text;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1800);
  }

  /* ---------- 底部 tab ---------- */
  function setActiveTab(key) {
    tabbarEl.querySelectorAll('.tab').forEach((b) => {
      b.setAttribute('aria-selected', String(b.dataset.tab === key));
    });
  }

  function syncTabs() {
    if (state.page) { setActiveTab(state.page); return; }
    setActiveTab(state.mode === 'weekly' ? 'week' : (isSideMode() ? 'mode' : 'game'));
  }

  function refreshDailyBadge() {
    if (!modeDailyLeftEl) return;
    const rec = loadDaily();
    modeDailyLeftEl.textContent = rec.done ? '已完成' : rec.left + ' 次';
  }

  function weekKey() {
    const now = new Date();
    const t = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const day = (t.getDay() + 6) % 7;
    t.setDate(t.getDate() - day + 3);
    const first = new Date(t.getFullYear(), 0, 4);
    const days = Math.round((t - first) / 86400000);
    return t.getFullYear() + '-W' + pad2(1 + Math.floor(days / 7));
  }

  function loadWeek() {
    const r = readStore(WEEK_KEY, null);
    const k = weekKey();
    if (!r || r.key !== k) return { key: k, best: 0, plays: 0 };
    return { key: k, best: Number(r.best) || 0, plays: Number(r.plays) || 0 };
  }

  function saveWeek(r) { writeStore(WEEK_KEY, r); }

  function weekRangeText() {
    const now = new Date();
    const day = (now.getDay() + 6) % 7;
    const mon = new Date(now.getFullYear(), now.getMonth(), now.getDate() - day);
    const sun = new Date(mon.getFullYear(), mon.getMonth(), mon.getDate() + 6);
    return (mon.getMonth() + 1) + '月' + mon.getDate() + '日 – ' + (sun.getMonth() + 1) + '月' + sun.getDate() + '日';
  }

  function renderWeekPage() {
    if (!weekPageEl) return;
    const rec = loadWeek();
    state.weekBest = rec.best;
    weekBestEl.textContent = rec.best.toLocaleString('zh-CN');
    weekChipBestEl.textContent = rec.best.toLocaleString('zh-CN');
    weekPlaysEl.textContent = rec.plays;
    weekRangeEl.textContent = '本周棋局 · ' + weekRangeText();
  }

  function seasonKey() {
    const m = new Date().getMonth() + 1;
    if (m >= 3 && m <= 5) return 'spring';
    if (m >= 6 && m <= 8) return 'summer';
    if (m >= 9 && m <= 11) return 'autumn';
    return 'winter';
  }

  function syncSeason() {
    const k = seasonKey();
    document.documentElement.setAttribute('data-season', k);
    if (seasonNameEl) {
      seasonNameEl.textContent = SEASON_NAMES[k];
      seasonNameEl.title = SEASON_RULE[k] || '';
    }
  }

  function loadModeBest(key) {
    try {
      const v = Number(localStorage.getItem(key) || 0);
      return Number.isFinite(v) ? Math.max(0, v) : 0;
    } catch (err) { return 0; }
  }

  function saveModeBest(key, score) {
    const best = Math.max(loadModeBest(key), score || 0);
    try { localStorage.setItem(key, String(best)); } catch (err) { /* 忽略 */ }
    return best;
  }

  function isSideMode() { return SIDE_MODES.indexOf(state.mode) >= 0; }

  function rememberStory() {
    if (state.mode === 'story') {
      state.storyLevel = state.level;
      state.storyScore = state.score;
    }
  }

  function loadStoryLevel() {
    const n = Number(readStore(STORY_KEY, 1)) || 1;
    return Math.max(1, Math.min(99999, Math.floor(n)));
  }

  function renderDexPage() {
    const c = loadCollect();
    const order = TYPES.slice();
    let total = 0;
    for (const t of order) total += c[t] || 0;
    let stars = 0;
    const allStars = loadStars();
    for (const k in allStars) stars += Number(allStars[k]) || 0;
    let seals = 0;
    const cards = order.map((t) => {
      const n = c[t] || 0;
      const s1 = n >= 50, s2 = n >= 100;
      if (s1) seals++;
      if (s2) seals++;
      return '<div class="dex-card' + (n ? '' : ' zero') + (s2 ? ' max' : '') + '">'
        + '<span class="dex-art"><svg viewBox="0 0 100 100" aria-hidden="true">' + (PIECES[t] || '') + '</svg></span>'
        + '<b>' + (TYPE_NAMES[t] || t) + '</b>'
        + '<em>' + (n ? '×' + n : '还没收') + '</em>'
        + '<span class="dex-seals">'
        + '<span class="seal' + (s1 ? ' on' : '') + '" title="小印：收满 50 颗">收</span>'
        + '<span class="seal gold' + (s2 ? ' on' : '') + '" title="满印：收满 100 颗">满</span>'
        + '</span>'
        + '</div>';
    }).join('');
    dexGridEl.innerHTML = cards;
    dexTotalEl.textContent = total;
    dexFootEl.innerHTML = '<span>总计 <b>' + total + '</b> 颗</span>'
      + '<span>印章 <b>' + seals + '</b>/' + (order.length * 2) + '</span>'
      + '<span>三星 <b>' + stars + '</b> 颗</span>'
      + '<span>最高 <b>' + getBest().toLocaleString('zh-CN') + '</b> 分</span>';
  }

  function renderSettingsPage() {
    setPanelEl.innerHTML = '<div class="set-list">'
      + '<div class="set-row"><div class="st"><b>重开本关</b><span>当前这一局从头再来</span></div>'
      + '<button class="set-btn" type="button" data-act="restart">重开</button></div>'
      + '<div class="set-row"><div class="st"><b>音效</b><span>摘果、点灯的合成声</span></div>'
      + '<button class="set-btn" type="button" data-act="sound">' + (state.muted ? '已静音' : '开着') + '</button></div>'
      + '<div class="set-row"><div class="st"><b>换色</b><span>十套预设，也能自己调一个</span></div>'
      + '<button class="set-btn" type="button" data-act="theme">去换色</button></div>'
      + '<div class="set-row"><div class="st"><b>主页</b><span>回到兔子主页</span></div>'
      + '<button class="set-btn" type="button" data-act="home">返回主页</button></div>'
      + '</div>';
    if (setOilEl) setOilEl.textContent = state.oil;
  }

  function openPage(kind) {
    ensureAudio();
    if (state.busy) { toast('等这一手消完再开'); return; }
    closeThemePop();
    stopHintTimer();
    clearHint();
    if (toastEl) { toastEl.classList.remove('show'); clearTimeout(toastTimer); }
    state.page = kind;
    state.paused = true;
    gameEl.hidden = true;
    dexPageEl.hidden = kind !== 'dex';
    setPageEl.hidden = kind !== 'setting';
    weekPageEl.hidden = kind !== 'week';
    modePageEl.hidden = kind !== 'mode';
    document.body.classList.add('page-open');
    if (kind === 'dex') renderDexPage();
    else if (kind === 'week') renderWeekPage();
    else if (kind === 'mode') renderModePage();
    else renderSettingsPage();
    setActiveTab(kind);
    window.scrollTo(0, 0);
  }

  function closePage() {
    if (!state.page) return;
    dexPageEl.hidden = true;
    setPageEl.hidden = true;
    weekPageEl.hidden = true;
    modePageEl.hidden = true;
    gameEl.hidden = false;
    state.page = null;
    state.paused = false;
    document.body.classList.remove('page-open');
    syncTabs();
    scheduleHint();
  }

  function toggleSound() {
    state.muted = !state.muted;
    if (!state.muted) { ensureAudio(); playSwap(); }
    toast(state.muted ? '已静音' : '音效打开');
    if (state.page === 'setting') renderSettingsPage();
  }

  function doRestart() {
    ensureAudio();
    if (state.mode === 'daily') { startDailyRun(loadDaily()); toast('重开这一盘'); return; }
    if (state.mode === 'weekly') { startWeekly(); return; }
    if (state.mode === 'score') { startScoreRun(); return; }
    if (state.mode === 'zen') { startZen(); return; }
    if (state.mode === 'challenge') { startChallenge(); return; }
    retryLevel(true);
  }

  themePop.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('click', () => { if (!themePop.hidden) closeThemePop(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeThemePop(); });

  hintBtn.addEventListener('click', () => {
    ensureAudio();
    if (state.busy || state.paused || state.over) return;
    const found = showHint(true);
    if (!found) {
      if (coverAt.size && state.goal && state.goal.type === 'fog') {
        const firstK = coverAt.keys().next().value;
        if (firstK) {
          coverAt.delete(firstK);
          renderCovers();
          state.goal.got = Math.min(state.goal.need, state.goal.got + 1);
          updateGoalUi();
        }
        toast('雾太厚，先散开一格');
      } else if (coverAt.size) {
        coverAt.clear();
        renderCovers();
      }
      shuffleBoard(true);
    }
  });


  starRowEl.addEventListener('click', () => {
    const t = starTargetNow();
    toast('1★ 完成目标 · 2★ 余步≥4 · 3★ 本关 ' + t.toLocaleString('zh-CN') + ' 分');
  });

  weatherBtn.addEventListener('click', () => {
    ensureAudio();
    const meta = WEATHER_META[state.weather] || WEATHER_META.sunny;
    toast(meta.name + ' · ' + meta.rule);
    playSwap();
  });


  tabbarEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.tab');
    if (!btn) return;
    const key = btn.dataset.tab;
    if (key === 'mode') { openPage('mode'); return; }
    if (key === 'dex' || key === 'setting' || key === 'week') {
      if (key === 'week' && state.mode === 'weekly' && !state.over) {
        toast('本周棋局还在走，先下完这一盘');
        return;
      }
      openPage(key);
      return;
    }
    if (state.page) closePage();
    if (state.mode === 'weekly') exitWeekly();
    else if (isSideMode()) exitSideMode();
    setActiveTab('game');
  });

  weekStartBtn.addEventListener('click', () => {
    if (state.busy) { toast('等这一手消完'); return; }
    closePage();
    startWeekly();
  });

  modeListEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-mode]');
    if (btn) startMode(btn.dataset.mode);
  });

  setPanelEl.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-act]');
    if (!btn) return;
    const act = btn.dataset.act;
    if (act === 'sound') toggleSound();
    else if (act === 'restart') { closePage(); doRestart(); }
    else if (act === 'home') {
      window.location.href = 'https://jyx010320-gif.github.io/RabbitOvOTsuki/';
    }
    else if (act === 'theme') { e.stopPropagation(); document.body.classList.add('theme-open'); openThemePop(); }
    else if (act === 'daily') {
      closePage();
      startDaily();
      setActiveTab(state.mode === 'weekly' ? 'week' : (isSideMode() ? 'mode' : 'game'));
    }
  });
  oilBtn.addEventListener('click', openToolsSheet);
  sheetToolsEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.tool');
    if (!btn || btn.disabled) return;
    useTool(btn.dataset.tool);
  });

  window.addEventListener('resize', () => { drag = null; });

  /* ============================================================
     启动
     ============================================================ */
  document.addEventListener('contextmenu', (e) => e.preventDefault());
  if (document.fonts && document.fonts.load) {
    document.fonts.load('28px "ZCOOL KuaiLe"', '三消小院').catch(() => {});
  }
  initTheme();
  initOil();
  syncSeason();
  renderWeekPage();
  refreshDailyBadge();
  buildLanterns();
  refreshBest();
  startLevel(loadStoryLevel(), true);
  maybeShowGuide();
})();
</script>
</body>
</html>
