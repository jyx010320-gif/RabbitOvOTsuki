.set-row:last-child{border-bottom:0}
.set-row .st{display:flex;flex-direction:column;gap:1px;min-width:0}
.set-row .st b{font-size:13px;font-weight:500;color:var(--ink)}
.set-row .st span{font-size:11px;color:var(--muted);letter-spacing:.02em}
.set-btn{
  appearance:none;cursor:pointer;flex:none;padding:6px 13px;border-radius:999px;
  border:1px solid var(--frame-line);background:var(--btn-bg);color:var(--ink-soft);
  font-family:inherit;font-size:12px;letter-spacing:.04em;
}
.set-btn:hover{border-color:var(--frame-line-strong);color:var(--ink)}
.set-kicker{margin:15px 0 7px;padding-left:2px;font-size:11px;letter-spacing:.16em;color:var(--accent)}
.set-help{
  background:var(--face-1);border:1px solid var(--frame-line);border-radius:18px;
  padding:2px 16px 4px;box-shadow:0 18px 34px -30px var(--shadow-ink);
}
.set-help p{margin:0;padding:10px 0;border-bottom:1px solid var(--hairline);font-size:11.5px;line-height:1.75;color:var(--muted)}
.set-help p:last-child{border-bottom:0}
.set-note{margin:14px 0 0;padding-top:12px;border-top:1px solid var(--hairline);font-size:11.5px;line-height:1.75;color:var(--muted)}

/* ============ 游玩模式页 ============ */
.mode-list{display:flex;flex-direction:column;gap:9px}
.mode-card{
  appearance:none;cursor:pointer;width:100%;display:grid;grid-template-columns:40px minmax(0,1fr) auto;
  align-items:center;gap:11px;
  padding:12px 14px;border-radius:16px;border:1px solid var(--frame-line);
  background:var(--face-1);color:var(--ink);font-family:inherit;text-align:left;
  box-shadow:0 14px 28px -28px var(--shadow-ink);
  transition:border-color .14s ease,background .14s ease,transform .1s ease;
}
.mode-card:hover{border-color:var(--frame-line-strong)}
.mode-card:active{transform:translateY(1px)}
.mode-ico{flex:none;display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:12px;
  background:color-mix(in srgb,var(--accent) 10%,var(--face-1));color:var(--accent)}
.mode-ico svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.mode-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.mode-copy b{font-size:14.5px;font-weight:600;letter-spacing:.04em}
.mode-copy span{font-size:11.5px;line-height:1.5;color:var(--muted)}
.mode-meta{font-size:10px;letter-spacing:.04em;color:var(--accent);opacity:.85;text-align:left;font-variant-numeric:tabular-nums}
.mode-pill{flex:none;padding:5px 9px;border-radius:999px;border:1px solid var(--frame-line);
  background:var(--face-panel);font-size:10.5px;letter-spacing:.06em;color:var(--accent)}
.mode-resume .mode-ico{background:var(--primary-b);color:var(--primary-fg)}
.mode-resume .mode-pill{background:var(--primary-b);color:var(--primary-fg);border-color:transparent}

/* ============ 周赛页 ============ */
.week-card{
  background:var(--face-1);border:1px solid var(--frame-line);border-radius:20px;
  padding:18px 18px 16px;box-shadow:0 22px 40px -34px var(--shadow-ink);
  display:flex;flex-direction:column;gap:14px;
}
.week-kicker{margin:0;font-size:11px;letter-spacing:.2em;color:var(--accent)}
.week-title{margin:2px 0 0;font-family:"ZCOOL KuaiLe",sans-serif;font-weight:400;font-size:clamp(22px,6vw,28px);color:var(--title);letter-spacing:.06em}
.week-nums{display:flex;gap:26px}
.week-num{display:flex;flex-direction:column;gap:1px}
.week-num span{font-size:10.5px;letter-spacing:.12em;color:var(--muted)}
.week-num b{font-family:inherit;font-weight:600;font-size:27px;line-height:1.15;color:var(--accent);font-variant-numeric:tabular-nums;letter-spacing:.01em}
.week-note{margin:0;font-size:12px;line-height:1.7;color:var(--ink-soft)}
.week-btn{
  appearance:none;cursor:pointer;width:100%;padding:11px 14px;border-radius:12px;
  border:0;background:var(--primary-b);color:var(--primary-fg);
  font-family:inherit;font-size:14px;letter-spacing:.12em;
  box-shadow:0 4px 0 var(--cut);
}
.week-btn:active{transform:translateY(2px);box-shadow:0 2px 0 var(--cut)}
.week-rules{display:flex;flex-direction:column;gap:9px;padding:4px 6px 0}
.week-rules li{display:flex;gap:9px;align-items:flex-start;font-size:12px;line-height:1.6;color:var(--ink-soft)}
.week-rules svg{width:15px;height:15px;flex:none;margin-top:2px;stroke:var(--accent);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}

/* ============ 宽屏：引言 + 棋盘 ============ */
@media (min-width:760px){
  body{padding:36px 32px calc(36px + 66px + env(safe-area-inset-bottom))}
  .game{flex-direction:row;align-items:center;gap:clamp(30px,5vw,66px)}
  .intro{flex:1 1 0;max-width:330px;gap:24px;padding-top:2px}
  .lede{display:block;margin:0;font-size:13.5px;line-height:1.95;color:var(--ink-soft);max-width:19em}
  .play{flex:1 1 auto;width:440px;max-width:440px}
  .head{flex-direction:row;align-items:flex-start;gap:16px}
  .brand h1{font-size:clamp(34px,3.4vw,42px)}
  .rules{display:flex;flex-direction:column;gap:16px;padding-top:22px;border-top:1px solid var(--hairline)}
  .best{display:flex}
  .stage{width:440px;max-width:440px}
  .stats{padding:0 4px}
  .foot{display:flex;justify-content:flex-start;padding-left:4px}
  .foot button{padding:10px 16px}
}

/* ============ 小屏 ============ */
@media (max-height:720px){
  body{padding:10px 14px calc(10px + 62px + env(safe-area-inset-bottom))}
  .game{gap:10px}
  .tagline{display:none}
  .head{padding-right:88px}
  .brand h1{font-size:clamp(22px,6.4vw,26px)}
  .stat strong{font-size:24px}
  .stage{width:min(100%,440px,calc(100dvh - 312px))}
  .foot button{padding:8px 6px;min-height:44px;font-size:11.5px;letter-spacing:.04em;gap:4px}
  .foot button svg{width:13px;height:13px}
  .foot{gap:6px}
  .play{gap:10px}
}
@media (prefers-reduced-motion:reduce){
  .ambient .firefly{animation:none}
  .tile .art{transition:none}
  .overlay,.sheet,.toast{animation:none}
}

/* ============================================================
   v7 · 多边形贴纸皮肤（页面层）
   ============================================================ */
:root{
  --poly-btn:polygon(9px 0,100% 3px,calc(100% - 8px) 100%,0 calc(100% - 3px));
  --poly-chip:polygon(11px 0,100% 3px,calc(100% - 10px) 100%,0 calc(100% - 3px));
  --poly-title:polygon(1% 2%,100% 0,98% 96%,0 100%);
}

/* —— 底纸：平铺 + 剪纸上坡 —— */
body::before{background:var(--page-solid)}
.ambient::before{
  content:"";position:absolute;left:-4%;right:-4%;bottom:-6%;height:44%;
  background:var(--hill-a);opacity:.95;
  clip-path:polygon(0 36%,12% 26%,30% 42%,48% 28%,68% 44%,86% 32%,100% 42%,100% 100%,0 100%);
}
.ambient::after{
  content:"";position:absolute;left:0;right:0;bottom:-2%;height:24%;
  background:var(--hill-b);opacity:.95;
  clip-path:polygon(0 44%,18% 32%,38% 50%,62% 34%,82% 48%,100% 36%,100% 100%,0 100%);
}
.ambient .scene{opacity:.14;filter:none}
.ambient .glow{display:none}
.ambient .firefly{
  width:8px;height:8px;border-radius:0;box-shadow:none;
  clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);
  background:var(--firefly);opacity:.5;
}

/* —— 通用贴纸壳：奶油切线 + 硬投影 —— */
.stk{position:relative;display:inline-flex;isolation:isolate;
  filter:drop-shadow(0 3px 5px var(--shadow-ink));}
.stk::before{content:"";position:absolute;inset:-3px;background:var(--cut);
  clip-path:var(--poly-btn);z-index:-2}
.stk::after{content:"";position:absolute;inset:0;background:var(--face-1);
  clip-path:var(--poly-btn);z-index:-1}
.stk > button,.stk > .chip{
  background:transparent;border:0;box-shadow:none;clip-path:none;filter:none;
  position:relative;z-index:0;
}
.stk-title{display:inline-flex}
.stk-title{--poly-btn:var(--poly-title);transform:rotate(-1deg)}
.stk-chip{--poly-btn:var(--poly-chip);transform:rotate(-0.8deg)}
.stk-btn{display:flex;flex:1 1 auto}
.stk-btn::after,.stk-chip::after,.stk-title::after{background:var(--face-1)}
.stk-title::after{background:var(--face-1hi)}
.stk-primary{display:flex;width:100%}
.stk-primary::after{background:var(--primary-b)}
.stk-toast{display:inline-flex}
.stk-toast::after{background:var(--face-sheet)}

/* —— 标题牌 —— */
.brand h1{
  display:inline-block;white-space:nowrap;
  margin:0;padding:6px 15px 10px;text-shadow:none;
  position:relative;z-index:1;
}
.brand .tagline{margin-top:9px}

/* —— 按钮：留空给壳，只负责文字 —— */
.theme-btn,.weather-chip,.oil-chip,.level-chip,.foot button{
  border:0;border-radius:0;background:transparent;color:var(--btn-fg);
  transition:background .14s ease,color .14s ease;
}
.theme-btn:hover,.weather-chip:hover,.oil-chip:hover,.foot button:hover{
  background:rgba(255,255,255,.07);color:var(--btn-fg-hover);
}
[data-theme="day"] .theme-btn:hover,[data-theme="day"] .weather-chip:hover,[data-theme="day"] .oil-chip:hover,[data-theme="day"] .foot button:hover{
  background:rgba(0,0,0,.05);
}
.foot button[aria-pressed="false"]{color:var(--muted);background:transparent}
.foot button{width:100%;justify-content:center}
.foot button svg{stroke-width:1.4}
.weather-chip .wicon svg{stroke:var(--accent)}
.foot button[aria-pressed="false"] svg{stroke:var(--muted)}
.theme-btn .stk{}

/* 壳内元素只留内容 */
.toast{border:0;border-radius:0;background:transparent;color:var(--ink)}
.sheet .primary{
  width:100%;border:0;border-radius:0;background:transparent;box-shadow:none;filter:none;
  position:relative;z-index:0;color:var(--primary-fg);
}
.sheet .primary:hover{filter:none;background:rgba(255,255,255,.08)}

/* —— 数字与进度：斜切纸条 —— */
.stat strong{
  font-family:"Noto Sans SC",system-ui,sans-serif;font-weight:600;
  font-size:27px;letter-spacing:.01em;
}
.track{
  height:5px;border-radius:0;overflow:hidden;
  background:var(--track-bg);
  transform:skewX(-6deg);
  box-shadow:0 0 0 1px var(--cut),0 2px 5px var(--shadow-ink);
  clip-path:none;filter:none;
}
.track i{border-radius:0;background:var(--accent);background-image:none}

/* —— 棋盘：手剪贴纸 —— */
.tray{padding:0;background:transparent;border:0;box-shadow:none;border-radius:0}
.tray::before{
  content:"";position:absolute;inset:2px 2px -9px 2px;z-index:0;
  background:var(--face-panel);
  clip-path:polygon(16px 0,100% 6px,calc(100% - 11px) 100%,0 calc(100% - 16px));
}

.board{
  position:relative;z-index:2;border-radius:0;box-shadow:0 0 0 1px var(--board-ring),0 12px 24px -16px rgba(0,0,0,.48);
  background-image:
    repeating-conic-gradient(var(--checker) 0% 25%, transparent 0% 50%),
    linear-gradient(var(--grid) 1px,transparent 1px),
    linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:25% 25%,12.5% 12.5%,12.5% 12.5%;
}
.cover-layer,.fx,.court{border-radius:0}
.court{background:var(--court-glow)}
.tile .art{filter:drop-shadow(0 1px 0 var(--art-shadow))}
.tile.sel::after{inset:2px;border-radius:4px;box-shadow:0 0 0 1px var(--accent),0 0 14px var(--hint-glow)}
.tile.hint::after{inset:2px;border-radius:4px;box-shadow:0 0 0 1px var(--accent),0 0 16px var(--hint-glow)}
.tile.hint .art{filter:drop-shadow(0 1px 0 var(--art-shadow)) drop-shadow(0 0 10px var(--hint-glow))}
.tile.special-bomb::before,.tile.special-rainbow::before{
  border-radius:0;background:none;
  clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);
  box-shadow:inset 0 0 0 1px var(--hint-glow);
}

/* —— 灯笼 —— */
.lantern.on{filter:drop-shadow(0 0 6px var(--hint-glow))}
.lantern.on .lg-body{fill:#F6C987}
.lantern.on .lg-line{stroke:#B87A38}
.lantern.on .lg-cap{fill:#B8803F}

/* —— 浮字 —— */
.float{text-shadow:0 2px 0 rgba(255,255,255,.65)}
.combo{text-shadow:0 3px 0 rgba(255,255,255,.72)}

/* toast 必须保持 fixed，不被贴纸壳的 relative 覆盖 */
.toast.stk{position:fixed;display:inline-flex;text-align:center;line-height:1.5;max-width:min(86vw,520px)}

/* —— 面板卡 —— */
.theme-pop{
  border:0;border-radius:0;background:transparent;box-shadow:none;
  position:relative;isolation:isolate;padding:16px 14px 13px;
}
.theme-pop::before{
  content:"";position:absolute;inset:-1px;z-index:-2;background:var(--cut);
  clip-path:polygon(5% 0,100% 3%,96% 100%,0 95%);
}
.theme-pop::after{
  content:"";position:absolute;inset:0;z-index:-1;background:var(--face-sheet);
  clip-path:polygon(5% 0,100% 3%,96% 100%,0 95%);
}
.theme-dots i{
  width:13px;height:13px;border-radius:0;transform:rotate(45deg);
  box-shadow:none;outline:1.5px solid var(--cut);
}
.theme-item{border-radius:0}
.sheet{
  border:0;border-radius:0;background:transparent;box-shadow:none;
  position:relative;isolation:isolate;padding:30px 26px 24px;
  filter:drop-shadow(0 10px 20px rgba(0,0,0,.2));
}
.sheet::before{
  content:"";position:absolute;inset:-1px;z-index:-2;background:var(--cut);
  clip-path:polygon(4% 0,100% 4%,96% 100%,0 94%);
}
.sheet::after{
  content:"";position:absolute;inset:0;z-index:-1;background:var(--face-sheet);
  clip-path:polygon(4% 0,100% 4%,96% 100%,0 94%);
}
/* 浅色纸上：棋子改用墨线描边，贴纸切边随之收细 */
.tile .art svg path[stroke="#FFF3DC"]{stroke:var(--piece-cut);stroke-width:1.45}
.tile .art svg path[stroke="#E7D2A8"]{stroke:var(--piece-cut);stroke-width:1.25}
.tile .art svg circle[fill="#FFEFC6"]{fill:var(--piece-cut)}
.tile .art svg path[stroke="#C6544D"]{stroke:var(--piece-crease)}
.tile .art svg path[stroke="#4E9B74"]{stroke:var(--piece-vein)}
.tile .art svg path[stroke="#D7F0FF"]{stroke:var(--piece-glint)}
/* —— 自定义取色器 —— */
.theme-pop{width:min(88vw,320px);max-height:calc(100vh - 70px);overflow-y:auto;padding:16px 16px 14px}
.custom-theme{display:flex;align-items:center;gap:8px;margin-top:11px;padding-top:12px;border-top:1px dashed var(--frame-line)}
.custom-theme.on{border-top-color:var(--accent)}
.custom-theme input[type=color]{width:34px;height:34px;flex:none;border:0;padding:2px;background:#fff;border-radius:3px;box-shadow:0 0 0 1px var(--cut),0 3px 6px var(--shadow-ink);cursor:pointer}
.custom-theme input[type=color]::-webkit-color-swatch-wrapper{padding:0}
.custom-theme input[type=color]::-webkit-color-swatch{border:0;border-radius:1px}
.custom-theme input[type=color]::-moz-color-swatch{border:0;border-radius:1px}
.ct-info{flex:1;min-width:0}
.ct-t{margin:0;font-size:12px;font-weight:600;color:var(--ink);letter-spacing:.03em}
.ct-t em{font-style:normal;font-weight:400;font-size:10.5px;color:var(--cut);margin-left:5px}
.ct-d{margin:1px 0 0;font-size:10.5px;line-height:1.45;color:var(--muted)}
.mini-btn{appearance:none;cursor:pointer;flex:none;border:0;padding:7px 9px;font-family:inherit;font-size:11.5px;letter-spacing:.06em;color:#fff;background:var(--accent);clip-path:polygon(5px 0,100% 2px,calc(100% - 4px) 100%,0 calc(100% - 2px));transition:filter .15s ease}
.mini-btn:hover{filter:brightness(1.06)}
.mini-btn:active{transform:translateY(1px)}
.mini-btn:focus-visible{outline:1px solid var(--ink);outline-offset:2px}
/* 统一按钮外形：很小圆角的方形，保留原有背景色 */
button{border-radius:2px!important;clip-path:none!important}
.stk{transform:none!important}
.stk::before,.stk::after{clip-path:none!important;border-radius:2px!important}
.stk::before{inset:-1px}
.tab[aria-selected="true"]{border-radius:12px!important}
/* 弹窗：四四方方，只留很小圆角 */
.sheet,.theme-pop{border-radius:2px!important}
.sheet::before,.sheet::after,.theme-pop::before,.theme-pop::after{clip-path:none!important;border-radius:2px!important}
</style>
